{
  "name": "julia",
  "displayName": "Julia",
  "publisher": "hajiboom",
  "icon": "images/icon.png",
  "description": "A minimal light theme, no fancy highlights, eye-friendly",
  "version": "1.1.0",
  "scripts": {
    "build:zed": "node scripts/build-zed-theme.js",
    "build:opencode": "node scripts/build-opencode-theme.js",
    "build:codex": "node scripts/build-codex-theme.js",
    "build:claude": "node scripts/build-claude-theme.js",
    "build:themes": "npm run build:opencode && npm run build:codex && npm run build:claude"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "simple-light",
        "uiTheme": "vs",
        "path": "./themes/simple-light-color-theme.json"
      },
      {
        "label": "simple-dark", 
        "uiTheme": "vs-dark",
        "path": "./themes/simple-dark-color-theme.json"
      }
    ]
  }
}
