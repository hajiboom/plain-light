{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": [
      "cyan",
      "purple",
      "green",
      "blue",
      "orange"
    ],
    "text": {
      "base": "$hue.neutral.200",
      "muted": "$hue.neutral.300",
      "faint": "$hue.neutral.400",
      "action": {
        "primary": {
          "base": "$hue.accent.200",
          "$hovered": "$hue.accent.100",
          "$focused": "$hue.accent.200",
          "$selected": "$hue.accent.100",
          "$disabled": "$hue.neutral.400"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base",
          "$focused": "$hue.interactive.200",
          "$disabled": "$hue.neutral.400"
        },
        "destructive": {
          "base": "$hue.red.200",
          "$hovered": "$hue.red.100",
          "$focused": "$hue.red.200",
          "$disabled": "$hue.neutral.400"
        }
      },
      "formfield": {
        "base": "$text.base",
        "$hovered": "$hue.interactive.200",
        "$focused": "$hue.interactive.200",
        "$pressed": "$hue.interactive.200",
        "$disabled": "$text.faint",
        "$selected": "$hue.interactive.200"
      },
      "feedback": {
        "error": {
          "base": "$hue.red.200"
        },
        "warning": {
          "base": "$hue.yellow.200"
        },
        "success": {
          "base": "$hue.green.200"
        },
        "info": {
          "base": "$hue.blue.200"
        }
      }
    },
    "background": {
      "base": "$hue.neutral.800",
      "raised": {
        "base": "$hue.neutral.700",
        "high": "$hue.neutral.600",
        "max": "$hue.neutral.500"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.600",
          "$focused": "$hue.interactive.600",
          "$selected": "$hue.interactive.600",
          "$disabled": "$hue.neutral.700"
        },
        "secondary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.600",
          "$focused": "$hue.interactive.600",
          "$selected": "$hue.interactive.600",
          "$disabled": "$hue.neutral.700"
        },
        "destructive": {
          "base": "$hue.red.700",
          "$hovered": "$hue.red.600",
          "$focused": "$hue.red.700",
          "$selected": "$hue.red.700",
          "$disabled": "$hue.neutral.700"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$background.raised.base"
        },
        "warning": {
          "base": "$background.raised.base"
        },
        "success": {
          "base": "$background.raised.base"
        },
        "info": {
          "base": "$background.raised.base"
        }
      }
    },
    "border": {
      "base": "$hue.neutral.500"
    },
    "scrollbar": {
      "base": "$hue.neutral.500"
    },
    "diff": {
      "text": {
        "added": "#58b85c",
        "removed": "#e84848",
        "context": "#a0a4a8",
        "hunkHeader": "#787c80"
      },
      "background": {
        "added": "#27392e",
        "removed": "#3c282b",
        "context": "$hue.neutral.700"
      },
      "highlight": {
        "added": "#a8e898",
        "removed": "#f89898"
      },
      "lineNumber": {
        "text": "#a8acb0",
        "background": {
          "added": "#283d30",
          "removed": "#42292c"
        }
      }
    },
    "syntax": {
      "comment": "#c89648",
      "keyword": "#ffe850",
      "function": "#d4d0c8",
      "variable": "#ddd8d2",
      "string": "#90e050",
      "number": "#a8c0a8",
      "type": "#a8c0a8",
      "operator": "#d8d4cc",
      "punctuation": "#d8d4cc"
    },
    "markdown": {
      "text": "#ddd8d2",
      "heading": "#ffe850",
      "link": "#90e0ff",
      "linkText": "#f0e080",
      "code": "#90e050",
      "blockQuote": "#c89648",
      "emphasis": "#c89648",
      "strong": "#d4d0c8",
      "horizontalRule": "#787c80",
      "listItem": "#ffe850",
      "listEnumeration": "#ffe850",
      "image": "#90e0ff",
      "imageText": "#f0e080",
      "codeBlock": "#ddd8d2"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.high"
          },
          "secondary": {
            "$hovered": "$background.raised.high"
          }
        }
      }
    }
  },
