{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": [
      "cyan",
      "purple",
      "green",
      "blue",
      "orange"
    ],
    "text": {
      "base": "$hue.neutral.200",
      "muted": "$hue.neutral.300",
      "faint": "$hue.neutral.400",
      "action": {
        "primary": {
          "base": "$hue.accent.200",
          "$hovered": "$hue.accent.100",
          "$focused": "$hue.accent.200",
          "$selected": "$hue.accent.100",
          "$disabled": "$hue.neutral.400"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base",
          "$focused": "$hue.interactive.200",
          "$disabled": "$hue.neutral.400"
        },
        "destructive": {
          "base": "$hue.red.200",
          "$hovered": "$hue.red.100",
          "$focused": "$hue.red.200",
          "$disabled": "$hue.neutral.400"
        }
      },
      "formfield": {
        "base": "$text.base",
        "$hovered": "$hue.interactive.200",
        "$focused": "$hue.interactive.200",
        "$pressed": "$hue.interactive.200",
        "$disabled": "$text.faint",
        "$selected": "$hue.interactive.200"
      },
      "feedback": {
        "error": {
          "base": "$hue.red.200"
        },
        "warning": {
          "base": "$hue.yellow.200"
        },
        "success": {
          "base": "$hue.green.200"
        },
        "info": {
          "base": "$hue.blue.200"
        }
      }
    },
    "background": {
      "base": "$hue.neutral.800",
      "raised": {
        "base": "$hue.neutral.700",
        "high": "$hue.neutral.600",
        "max": "$hue.neutral.500"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.600",
          "$focused": "$hue.interactive.600",
          "$selected": "$hue.interactive.600",
          "$disabled": "$hue.neutral.700"
        },
        "secondary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.600",
          "$focused": "$hue.interactive.600",
          "$selected": "$hue.interactive.600",
          "$disabled": "$hue.neutral.700"
        },
        "destructive": {
          "base": "$hue.red.700",
          "$hovered": "$hue.red.600",
          "$focused": "$hue.red.700",
          "$selected": "$hue.red.700",
          "$disabled": "$hue.neutral.700"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$background.raised.base"
        },
        "warning": {
          "base": "$background.raised.base"
        },
        "success": {
          "base": "$background.raised.base"
        },
        "info": {
          "base": "$background.raised.base"
        }
      }
    },
    "border": {
      "base": "$hue.neutral.500"
    },
    "scrollbar": {
      "base": "$hue.neutral.500"
    },
    "diff": {
      "text": {
        "added": "#7fb757",
        "removed": "#e35d64",
        "context": "#a6a6a6",
        "hunkHeader": "#6b6b6b"
      },
      "background": {
        "added": "#273021",
        "removed": "#362223",
        "context": "$hue.neutral.700"
      },
      "highlight": {
        "added": "#93cd6c",
        "removed": "#e8707a"
      },
      "lineNumber": {
        "text": "#9a9a9a",
        "background": {
          "added": "#2b3523",
          "removed": "#3d2426"
        }
      }
    },
    "syntax": {
      "comment": "#c18132",
      "keyword": "#d8bd55",
      "function": "#949bb0",
      "variable": "#c6c6c6",
      "string": "#7fb757",
      "number": "#dc7a45",
      "type": "#94b0a6",
      "operator": "#c6c6c6",
      "punctuation": "#c6c6c6"
    },
    "markdown": {
      "text": "#c6c6c6",
      "heading": "#d8bd55",
      "link": "#95a2c9",
      "linkText": "#d8bd55",
      "code": "#7fb757",
      "blockQuote": "#d99f57",
      "emphasis": "#d8bd55",
      "strong": "#c6c6c6",
      "horizontalRule": "#6b6b6b",
      "listItem": "#d8bd55",
      "listEnumeration": "#d8bd55",
      "image": "#95a2c9",
      "imageText": "#d8bd55",
      "codeBlock": "#c6c6c6"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.high"
          },
          "secondary": {
            "$hovered": "$background.raised.high"
          }
        }
      }
    }
  },
