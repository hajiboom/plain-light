{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": [
      "cyan",
      "purple",
      "green",
      "blue",
      "orange"
    ],
    "text": {
      "base": "$hue.neutral.200",
      "muted": "$hue.neutral.300",
      "faint": "$hue.neutral.400",
      "action": {
        "primary": {
          "base": "$hue.accent.200",
          "$hovered": "$hue.accent.100",
          "$focused": "$hue.accent.200",
          "$selected": "$hue.accent.100",
          "$disabled": "$hue.neutral.400"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base",
          "$focused": "$hue.interactive.200",
          "$disabled": "$hue.neutral.400"
        },
        "destructive": {
          "base": "$hue.red.200",
          "$hovered": "$hue.red.100",
          "$focused": "$hue.red.200",
          "$disabled": "$hue.neutral.400"
        }
      },
      "formfield": {
        "base": "$text.base",
        "$hovered": "$hue.interactive.200",
        "$focused": "$hue.interactive.200",
        "$pressed": "$hue.interactive.200",
        "$disabled": "$text.faint",
        "$selected": "$hue.interactive.200"
      },
      "feedback": {
        "error": {
          "base": "$hue.red.200"
        },
        "warning": {
          "base": "$hue.yellow.200"
        },
        "success": {
          "base": "$hue.green.200"
        },
        "info": {
          "base": "$hue.blue.200"
        }
      }
    },
    "background": {
      "base": "$hue.neutral.800",
      "raised": {
        "base": "$hue.neutral.700",
        "high": "$hue.neutral.600",
        "max": "$hue.neutral.500"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.600",
          "$focused": "$hue.interactive.600",
          "$selected": "$hue.interactive.600",
          "$disabled": "$hue.neutral.700"
        },
        "secondary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.600",
          "$focused": "$hue.interactive.600",
          "$selected": "$hue.interactive.600",
          "$disabled": "$hue.neutral.700"
        },
        "destructive": {
          "base": "$hue.red.700",
          "$hovered": "$hue.red.600",
          "$focused": "$hue.red.700",
          "$selected": "$hue.red.700",
          "$disabled": "$hue.neutral.700"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$background.raised.base"
        },
        "warning": {
          "base": "$background.raised.base"
        },
        "success": {
          "base": "$background.raised.base"
        },
        "info": {
          "base": "$background.raised.base"
        }
      }
    },
    "border": {
      "base": "$hue.neutral.500"
    },
    "scrollbar": {
      "base": "$hue.neutral.500"
    },
    "diff": {
      "text": {
        "added": "#79bf46",
        "removed": "#f43841",
        "context": "#a6a6a6",
        "hunkHeader": "#6b6b6b"
      },
      "background": {
        "added": "#27311f",
        "removed": "#391d1e",
        "context": "$hue.neutral.700"
      },
      "highlight": {
        "added": "#8fd94f",
        "removed": "#ff4f58"
      },
      "lineNumber": {
        "text": "#b3b3b3",
        "background": {
          "added": "#293620",
          "removed": "#401e1f"
        }
      }
    },
    "syntax": {
      "comment": "#c18132",
      "keyword": "#ffdd33",
      "function": "#949bb0",
      "variable": "#d4d4d4",
      "string": "#79bf46",
      "number": "#ff6200",
      "type": "#94b0a6",
      "operator": "#d4d4d4",
      "punctuation": "#d4d4d4"
    },
    "markdown": {
      "text": "#d4d4d4",
      "heading": "#ffdd33",
      "link": "#95a2c9",
      "linkText": "#ffdd33",
      "code": "#79bf46",
      "blockQuote": "#ff9b21",
      "emphasis": "#ffdd33",
      "strong": "#d4d4d4",
      "horizontalRule": "#6b6b6b",
      "listItem": "#ffdd33",
      "listEnumeration": "#ffdd33",
      "image": "#95a2c9",
      "imageText": "#ffdd33",
      "codeBlock": "#d4d4d4"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.high"
          },
          "secondary": {
            "$hovered": "$background.raised.high"
          }
        }
      }
    }
  },
