{
  "$schema": "vscode://schemas/color-theme",
  "name": "simple-light",
  "type": "light",
  "colors": {
    // ============================================================
    // 全局基调：暖白 (#F5F5F5) + 深灰字 (#1A1A1A)
    // 取自 Windows Terminal "Warm Light"：靠降对比度而非纯白/纯黑，
    // 减轻散光带来的光晕（halation）与边缘发虚
    // 标题栏保留 go.dev 藏蓝 (#007894)
    // ============================================================
    "contrastBorder": "#d4d4d4",
    "focusBorder": "#007894",
    "widget.shadow": "#00000010",

    // ---- 编辑器核心：暖白底，深灰字 ----
    "editor.background": "#f5f5f5",
    "editor.foreground": "#1a1a1a",
    "editorLineNumber.foreground": "#9e9e9e",
    "editorLineNumber.activeForeground": "#007894",
    "editor.lineHighlightBackground": "#ededed",
    "editor.selectionBackground": "#cce4ff",
    "editor.selectionHighlightBackground": "#e6e6e680",
    "editorCursor.foreground": "#007894",
    "editorWhitespace.foreground": "#dcdcdc",
    "editorIndentGuide.background1": "#e6e6e6",
    "editorIndentGuide.activeBackground1": "#b0b0b0",
    "editorRuler.foreground": "#e0e0e0",
    "editorBracketMatch.background": "#e8e8e8",
    "editorBracketMatch.border": "#007894",
    "editor.findMatchBackground": "#FDE3A7",
    "editor.findMatchHighlightBackground": "#FDE3A780",

    // ---- Git 变更提示 ----
    "editorGutter.addedBackground": "#1a7f37",
    "editorGutter.modifiedBackground": "#1b4b8f",
    "editorGutter.deletedBackground": "#b31d28",
    "minimapGutter.addedBackground": "#1a7f37",
    "minimapGutter.modifiedBackground": "#1b4b8f",
    "minimapGutter.deletedBackground": "#b31d28",
    "editorOverviewRuler.addedForeground": "#1a7f37",
    "editorOverviewRuler.modifiedForeground": "#1b4b8f",
    "editorOverviewRuler.deletedForeground": "#b31d28",
    "gitDecoration.addedResourceForeground": "#1a7f37",
    "gitDecoration.modifiedResourceForeground": "#1b4b8f",
    "gitDecoration.deletedResourceForeground": "#b31d28",
    "gitDecoration.untrackedResourceForeground": "#8a6100",
    "gitDecoration.ignoredResourceForeground": "#9e9e9e",

    // ---- 侧边栏：浅灰 ----
    "sideBar.background": "#ededed",
    "sideBar.foreground": "#1a1a1a",
    "sideBarSectionHeader.background": "#e6e6e6",
    "sideBarSectionHeader.foreground": "#1a1a1a",
    "sideBarTitle.foreground": "#1a1a1a",
    "sideBar.border": "#dcdcdc",

    // ---- 活动栏 ----
    "activityBar.background": "#e7e7e7",
    "activityBar.foreground": "#1a1a1a",
    "activityBar.inactiveForeground": "#6e6e6e",
    "activityBar.border": "#dcdcdc",
    "activityBar.activeBorder": "#007894",
    "activityBar.activeBackground": "#ededed",

    // ========== 标题栏：保留 go.dev 藏蓝 ==========
    "titleBar.activeBackground": "#007894",
    "titleBar.activeForeground": "#ffffff",
    "titleBar.inactiveBackground": "#005c72",
    "titleBar.inactiveForeground": "#d9d9d9",
    "titleBar.border": "#006982",

    // ---- 命令中心（新版 VSCode 编辑器顶部） ----
    "commandCenter.foreground": "#1a1a1a",
    "commandCenter.activeForeground": "#007894",
    "commandCenter.inactiveForeground": "#6e6e6e",
    "commandCenter.background": "#ededed",
    "commandCenter.activeBackground": "#e6e6e6",
    "commandCenter.border": "#dcdcdc",
    "commandCenter.inactiveBorder": "#dcdcdc80",
    "commandCenter.debuggingBackground": "#97640480",

    // ---- 菜单栏 ----
    "menu.background": "#ededed",
    "menu.foreground": "#1a1a1a",
    "menu.selectionBackground": "#cce4ff",
    "menu.selectionForeground": "#1a1a1a",
    "menu.border": "#b8b8b8",

    // ========== 底部状态栏：浅灰，藏蓝只保留在顶部标题栏 ==========
    "statusBar.background": "#ededed",
    "statusBar.foreground": "#1a1a1a",
    "statusBar.border": "#dcdcdc",
    "statusBar.debuggingBackground": "#976404",
    "statusBar.debuggingForeground": "#ffffff",
    "statusBar.noFolderBackground": "#ededed",
    "statusBar.focusBorder": "#007894",
    "statusBarItem.remoteBackground": "#ededed",
    "statusBarItem.remoteForeground": "#1a1a1a",
    "statusBarItem.warningBackground": "#976404",
    "statusBarItem.warningForeground": "#ffffff",
    "statusBarItem.errorBackground": "#b31d28",
    "statusBarItem.errorForeground": "#ffffff",

    // ---- 面板 / 终端：暖白底 + 降饱和度 ANSI ----
    "panel.background": "#ededed",
    "panel.border": "#dcdcdc",
    "panelTitle.activeForeground": "#007894",
    "panelTitle.inactiveForeground": "#9e9e9e",

    "terminal.background": "#f5f5f5",
    "terminal.foreground": "#1a1a1a",
    "terminal.selectionBackground": "#cce4ff80",
    "terminalCursor.foreground": "#007894",
    "terminal.ansiBlack": "#1a1a1a",
    "terminal.ansiRed": "#b31d28",
    "terminal.ansiGreen": "#1a7f37",
    "terminal.ansiYellow": "#8a6100",
    "terminal.ansiBlue": "#1b4f8f",
    "terminal.ansiMagenta": "#7a1fa2",
    "terminal.ansiCyan": "#0e6e7a",
    "terminal.ansiWhite": "#6e6e6e",
    "terminal.ansiBrightBlack": "#4d4d4d",
    "terminal.ansiBrightRed": "#d1242f",
    "terminal.ansiBrightGreen": "#22863a",
    "terminal.ansiBrightYellow": "#976404",
    "terminal.ansiBrightBlue": "#2c63a8",
    "terminal.ansiBrightMagenta": "#9a3fb8",
    "terminal.ansiBrightCyan": "#1a8a99",
    "terminal.ansiBrightWhite": "#1a1a1a",

    // ---- 列表 / 树 ----
    "list.activeSelectionBackground": "#cce4ff",
    "list.activeSelectionForeground": "#1a1a1a",
    "list.inactiveSelectionBackground": "#e6e6e6",
    "list.inactiveSelectionForeground": "#1a1a1a",
    "list.hoverBackground": "#ebebeb",
    "list.hoverForeground": "#1a1a1a",
    "list.focusBackground": "#cce4ff",
    "list.focusForeground": "#1a1a1a",
    "list.highlightForeground": "#123c63",

    // ---- 输入框 / 下拉 ----
    "input.background": "#fafafa",
    "input.foreground": "#1a1a1a",
    "input.border": "#d4d4d4",
    "input.placeholderForeground": "#9e9e9e",
    "inputOption.activeBorder": "#007894",
    "dropdown.background": "#fafafa",
    "dropdown.foreground": "#1a1a1a",
    "dropdown.border": "#d4d4d4",

    // ---- 按钮：保留 go 藏蓝 ----
    "button.background": "#007894",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#0090B8",
    "button.border": "#006982",

    // ---- 滚动条 ----
    "scrollbarSlider.background": "#c0c0c080",
    "scrollbarSlider.hoverBackground": "#9e9e9e80",
    "scrollbarSlider.activeBackground": "#00789480",

    // ---- 标签栏 ----
    "editorGroup.border": "#dcdcdc",
    "editorGroupHeader.tabsBackground": "#ebebeb",
    "editorGroupHeader.border": "#dcdcdc",
    "tab.activeBackground": "#f5f5f5",
    "tab.inactiveBackground": "#ebebeb",
    "tab.activeForeground": "#1a1a1a",
    "tab.inactiveForeground": "#6e6e6e",
    "tab.border": "#dcdcdc",
    "tab.activeBorder": "#007894",
    "tab.activeBorderTop": "#007894",
    "tab.unfocusedActiveBorderTop": "#dcdcdc",

    // ---- 通知 ----
    "notifications.background": "#fafafa",
    "notifications.foreground": "#1a1a1a",
    "notificationsWarningIcon.foreground": "#976404",
    "notificationsErrorIcon.foreground": "#b31d28",
    "notificationsInfoIcon.foreground": "#1b4b8f",

    // ---- 浮层 / 建议框 ----
    "badge.background": "#007894",
    "badge.foreground": "#ffffff",
    "progressBar.background": "#007894",
    "editorWidget.background": "#fafafa",
    "editorWidget.border": "#d4d4d4",
    "editorSuggestWidget.background": "#fafafa",
    "editorSuggestWidget.border": "#d4d4d4",
    "editorSuggestWidget.selectedBackground": "#cce4ff",
    "editorHoverWidget.background": "#fafafa",
    "editorHoverWidget.border": "#d4d4d4",
    "list.activeSelectionIconForeground": "#007894",

    // ---- 内联聊天 / Chat（新版 VSCode） ----
    "inlineChat.background": "#eeeeee",
    "inlineChat.foreground": "#1a1a1a",
    "inlineChat.border": "#dcdcdc",
    "inlineChatInput.background": "#fafafa",
    "inlineChatInput.border": "#d4d4d4",
    "inlineChatInput.focusBorder": "#007894",
    "chat.requestBackground": "#ededed",
    "chat.requestBorder": "#dcdcdc",
    "chat.slashCommandBackground": "#e0eef7",
    "chat.slashCommandForeground": "#007894",
    "chat.editedFileForeground": "#8a6100"
  },

  // ============================================================
  // 代码高亮：Linux vim 默认配色的暖白特调版
  //   vim 的语义映射原样保留 ——
  //     注释蓝 / 关键字橄榄 / 字符串红 / 类型绿 / 函数青 / 预处理洋红
  //   每个色都按暖白底 #f5f5f5 重新定亮度与饱和度：无纯饱和色，
  //   无紫色字符串，全部 ≥4.5:1（WCAG AA）。
  //   两处有意偏离 vim 默认：
  //     · 预处理 / 转义由洋红改为铁锈红 —— 不再引入紫色；
  //     · 数字 / 布尔 / 常量 / 变量 / 运算符保持正文深灰 ——
  //       vim 会把字面量染红，整屏见红反而增加视觉压力。
  // ============================================================
  "tokenColors": [
    // ---------- 注释：vim 蓝的降饱和版（板岩蓝灰） ----------
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#4b6577"
      }
    },

    // ---------- 关键字：vim 的黄，暖底上收成橄榄 ----------
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.flow",
        "keyword.control.return",
        "keyword.control.exception",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.declaration",
        "keyword.package.go", "keyword.import.go",
        "keyword.function.go", "keyword.type.go", "keyword.struct.go",
        "keyword.interface.go", "keyword.map.go", "keyword.chan.go",
        "storage.type", "storage.modifier"
      ],
      "settings": { "foreground": "#7a5c00" }
    },

    // ---------- 预处理 / 系统指令：铁锈红（替掉 vim 的洋红） ----------
    {
      "name": "Preprocessor",
      "scope": ["meta.preprocessor", "keyword.directive", "entity.name.tag.doctype"],
      "settings": { "foreground": "#8c3a1e" }
    },

    // ---------- HTML/JSX 标签名：与关键字同族 ----------
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "support.class.component"],
      "settings": { "foreground": "#7a5c00" }
    },

    // ---------- 属性名 / JSON key / YAML key：vim 青 ----------
    {
      "name": "Attributes & Keys",
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name.json",
        "entity.name.tag.yaml"
      ],
      "settings": { "foreground": "#0b6a78" }
    },

    // ---------- 字符串：vim 红（深砖红，非纯饱和） ----------
    {
      "name": "Strings",
      "scope": ["string", "punctuation.definition.string"],
      "settings": { "foreground": "#a3212b" }
    },

    // ---------- 转义 / 正则：铁锈红 ----------
    {
      "name": "Escape & Regexp",
      "scope": ["constant.character.escape", "string.regexp", "string.template"],
      "settings": { "foreground": "#8c3a1e" }
    },

    // ---------- 路径 / URL 等特殊字符串：vim 青 ----------
    {
      "name": "String Special",
      "scope": ["string.special", "string.other.link"],
      "settings": { "foreground": "#0b6a78" }
    },

    // ---------- 函数名：vim 青（Identifier 族） ----------
    {
      "name": "Function",
      "scope": [
        "entity.name.function", "support.function", "variable.function"
      ],
      "settings": { "foreground": "#0b6a78" }
    },

    // ---------- 类型 / 类名：vim 绿 ----------
    {
      "name": "Type",
      "scope": [
        "entity.name.type", "entity.name.class", "entity.name.type.class",
        "support.type", "support.class", "entity.name.namespace"
      ],
      "settings": { "foreground": "#1a7f37" }
    },

    // ---------- 数字 / 布尔 / 常量：正文深灰（有意不着色） ----------
    {
      "name": "Constants",
      "scope": [
        "constant.numeric", "constant.language", "constant.boolean",
        "variable.other.enummember"
      ],
      "settings": { "foreground": "#1a1a1a" }
    },

    // ---------- this / self / super：仅斜体，不换色 ----------
    {
      "name": "Language Variable",
      "scope": ["variable.language", "variable.language.this", "variable.language.super"],
      "settings": { "fontStyle": "italic" }
    },

    // ---------- 错误 / 非法（含未闭合字符串）：暗红 ----------
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#b31d28" }
    },

    // ---------- Markdown ----------
    {
      "name": "Markdown Heading",
      "scope": ["markup.heading", "entity.name.section.markdown"],
      "settings": { "foreground": "#7a5c00", "fontStyle": "bold" }
    },
    {
      "name": "Markdown Bold",
      "scope": "markup.bold",
      "settings": { "fontStyle": "bold" }
    },
    {
      "name": "Markdown Italic",
      "scope": "markup.italic",
      "settings": { "fontStyle": "italic" }
    },
    {
      "name": "Markdown Quote",
      "scope": "markup.quote",
      "settings": { "foreground": "#4b6577", "fontStyle": "italic" }
    },
    {
      "name": "Markdown Code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": { "foreground": "#a3212b" }
    },
    {
      "name": "Markdown List Marker",
      "scope": ["markup.list", "punctuation.definition.list.begin.markdown"],
      "settings": { "foreground": "#7a5c00" }
    },
    {
      "name": "Markdown Link",
      "scope": ["markup.link.url", "markup.underline.link"],
      "settings": { "foreground": "#0b6a78", "fontStyle": "underline" }
    }
  ]
}
