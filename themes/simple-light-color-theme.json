{
  "$schema": "vscode://schemas/color-theme",
  "name": "simple-light",
  "type": "light",
  "colors": {
    // ============================================================
    // 全局基调：macOS 风格暖白质感
    // Go 青蓝 (#007894) 从旧版标题栏移至底部状态栏
    // 终端采用 macOS mi Style 纯黑底
    // ============================================================
    "contrastBorder": "#d2cfcb",
    "focusBorder": "#007894",
    "widget.shadow": "#0000000e",

    // ---- 编辑器核心：暖白底 ----
    "editor.background": "#fafaf8",
    "editor.foreground": "#212121",
    "editorLineNumber.foreground": "#9e9c98",
    "editorLineNumber.activeForeground": "#0054A6",
    "editor.lineHighlightBackground": "#E5FADD",
    "editor.selectionBackground": "#CCE4FF",
    "editor.selectionHighlightBackground": "#D0F9F4",
    "editorCursor.foreground": "#0054A6",
    "editorWhitespace.foreground": "#e0ded9",
    "editorIndentGuide.background1": "#e8e5e0",
    "editorIndentGuide.activeBackground1": "#0054A6",
    "editorRuler.foreground": "#e8e5e080",
    "editorBracketMatch.background": "#E5FADD",
    "editorBracketMatch.border": "#0054A6",
    "editor.findMatchBackground": "#FDE3A7",
    "editor.findMatchHighlightBackground": "#FDE3A780",

    // ---- Git 变更提示 ----
    "editorGutter.addedBackground": "#388E3C",
    "editorGutter.modifiedBackground": "#1976D2",
    "editorGutter.deletedBackground": "#E11B14",
    "minimapGutter.addedBackground": "#388E3C",
    "minimapGutter.modifiedBackground": "#1976D2",
    "minimapGutter.deletedBackground": "#E11B14",
    "editorOverviewRuler.addedForeground": "#388E3C",
    "editorOverviewRuler.modifiedForeground": "#1976D2",
    "editorOverviewRuler.deletedForeground": "#E11B14",
    "gitDecoration.addedResourceForeground": "#388E3C",
    "gitDecoration.modifiedResourceForeground": "#1976D2",
    "gitDecoration.deletedResourceForeground": "#E11B14",
    "gitDecoration.untrackedResourceForeground": "#8B6606",
    "gitDecoration.ignoredResourceForeground": "#9e9c98",

    // ---- 侧边栏 ----
    "sideBar.background": "#f2f1ef",
    "sideBar.foreground": "#212121",
    "sideBarSectionHeader.background": "#ecebe8",
    "sideBarSectionHeader.foreground": "#212121",
    "sideBarTitle.foreground": "#212121",
    "sideBar.border": "#d9d6d2",

    // ---- 活动栏 ----
    "activityBar.background": "#ecebe8",
    "activityBar.foreground": "#212121",
    "activityBar.inactiveForeground": "#9e9c98",
    "activityBar.border": "#d9d6d2",
    "activityBar.activeBorder": "#007894",
    "activityBar.activeBackground": "#f2f1ef",

    // ========== 新版 VSCode 无独立标题栏，Go 青蓝移至底部状态栏 ==========
    // 保留 titleBar 配置供启用原生标题栏的用户使用
    "titleBar.activeBackground": "#007894",
    "titleBar.activeForeground": "#212121",
    "titleBar.inactiveBackground": "#005c72",
    "titleBar.inactiveForeground": "#555555",
    "titleBar.border": "#006982",

    // ---- 命令中心（新版 VSCode 编辑器顶部） ----
    "commandCenter.foreground": "#212121",
    "commandCenter.activeForeground": "#0054A6",
    "commandCenter.inactiveForeground": "#9e9c98",
    "commandCenter.background": "#f2f1ef",
    "commandCenter.activeBackground": "#e8e5e0",
    "commandCenter.border": "#d9d6d2",
    "commandCenter.inactiveBorder": "#d9d6d280",
    "commandCenter.debuggingBackground": "#B36205",

    // ---- 菜单栏 ----
    "menu.background": "#ffffff",
    "menu.foreground": "#212121",
    "menu.selectionBackground": "#CCE4FF",
    "menu.selectionForeground": "#212121",
    "menu.border": "#d2cfcb",

    // ========== 底部状态栏：Go 青蓝主题色 ==========
    "statusBar.background": "#007894",
    "statusBar.foreground": "#ffffff",
    "statusBar.border": "#006982",
    "statusBar.debuggingBackground": "#B36205",
    "statusBar.debuggingForeground": "#ffffff",
    "statusBar.noFolderBackground": "#007894",
    "statusBar.focusBorder": "#40b8d8",
    "statusBarItem.remoteBackground": "#006680",
    "statusBarItem.remoteForeground": "#ffffff",
    "statusBarItem.warningBackground": "#B36205",
    "statusBarItem.warningForeground": "#ffffff",
    "statusBarItem.errorBackground": "#C72824",
    "statusBarItem.errorForeground": "#ffffff",

    // ---- 面板 / 终端：暖白调，与整体一致 ----
    "panel.background": "#f2f1ef",
    "panel.border": "#d9d6d2",
    "panelTitle.activeForeground": "#0054A6",
    "panelTitle.inactiveForeground": "#9e9c98",

    "terminal.background": "#f2f1ef",
    "terminal.foreground": "#212121",
    "terminal.selectionBackground": "#CCE4FF80",
    "terminalCursor.foreground": "#0054A6",
    "terminal.ansiBlack": "#1a1a1a",
    "terminal.ansiRed": "#E11B14",
    "terminal.ansiGreen": "#008013",
    "terminal.ansiYellow": "#8B6606",
    "terminal.ansiBlue": "#0033CC",
    "terminal.ansiMagenta": "#A709F5",
    "terminal.ansiCyan": "#027880",
    "terminal.ansiWhite": "#c8c8c8",
    "terminal.ansiBrightBlack": "#777777",
    "terminal.ansiBrightRed": "#B7312C",
    "terminal.ansiBrightGreen": "#2E8B57",
    "terminal.ansiBrightYellow": "#C04C0B",
    "terminal.ansiBrightBlue": "#0054A6",
    "terminal.ansiBrightMagenta": "#9C27B0",
    "terminal.ansiBrightCyan": "#007095",
    "terminal.ansiBrightWhite": "#f0f0f0",

    // ---- 列表 / 树 ----
    "list.activeSelectionBackground": "#CCE4FF",
    "list.activeSelectionForeground": "#212121",
    "list.inactiveSelectionBackground": "#E8F4FD",
    "list.inactiveSelectionForeground": "#212121",
    "list.hoverBackground": "#E5FADD",
    "list.hoverForeground": "#212121",
    "list.focusBackground": "#CCE4FF",
    "list.focusForeground": "#212121",
    "list.highlightForeground": "#0033CC",

    // ---- 输入框 / 下拉 ----
    "input.background": "#ffffff",
    "input.foreground": "#212121",
    "input.border": "#c9c5c0",
    "input.placeholderForeground": "#9e9c98",
    "inputOption.activeBorder": "#007894",
    "dropdown.background": "#ffffff",
    "dropdown.foreground": "#212121",
    "dropdown.border": "#c9c5c0",

    // ---- 按钮 ----
    "button.background": "#007894",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#0090B8",
    "button.border": "#006982",

    // ---- 滚动条 ----
    "scrollbarSlider.background": "#d0cec980",
    "scrollbarSlider.hoverBackground": "#b0ada780",
    "scrollbarSlider.activeBackground": "#0054A680",

    // ---- 标签栏 ----
    "editorGroup.border": "#d9d6d2",
    "editorGroupHeader.tabsBackground": "#f2f1ef",
    "editorGroupHeader.border": "#d9d6d2",
    "tab.activeBackground": "#fafaf8",
    "tab.inactiveBackground": "#f2f1ef",
    "tab.activeForeground": "#0054A6",
    "tab.inactiveForeground": "#555555",
    "tab.border": "#d9d6d2",
    "tab.activeBorder": "#007894",
    "tab.activeBorderTop": "#007894",
    "tab.unfocusedActiveBorderTop": "#d9d6d2",

    // ---- 通知 ----
    "notifications.background": "#ffffff",
    "notifications.foreground": "#212121",
    "notificationsWarningIcon.foreground": "#B36205",
    "notificationsErrorIcon.foreground": "#E11B14",
    "notificationsInfoIcon.foreground": "#1656A7",

    // ---- 浮层 / 建议框 ----
    "badge.background": "#007894",
    "badge.foreground": "#ffffff",
    "progressBar.background": "#007894",
    "editorWidget.background": "#ffffff",
    "editorWidget.border": "#c9c5c0",
    "editorSuggestWidget.background": "#ffffff",
    "editorSuggestWidget.border": "#c9c5c0",
    "editorSuggestWidget.selectedBackground": "#D0F9F4",
    "editorHoverWidget.background": "#ffffff",
    "editorHoverWidget.border": "#c9c5c0",
    "list.activeSelectionIconForeground": "#0054A6",

    // ---- 内联聊天 / Chat（新版 VSCode） ----
    "inlineChat.background": "#f8f8f6",
    "inlineChat.foreground": "#212121",
    "inlineChat.border": "#d9d6d2",
    "inlineChatInput.background": "#ffffff",
    "inlineChatInput.border": "#c9c5c0",
    "inlineChatInput.focusBorder": "#007894",
    "chat.requestBackground": "#f2f1ef",
    "chat.requestBorder": "#d9d6d2",
    "chat.slashCommandBackground": "#D0F9F4",
    "chat.slashCommandForeground": "#027880",
    "chat.editedFileForeground": "#8B6606"
  },

  // ============================================================
  // 代码高亮：MATLAB 风格 + 终端色板灵感，更丰富的区分度
  // 从终端 ANSI 色板中吸取：青、橙、紫、绿、金 五种强调色
  // 搭配深浅蓝和黑色主色，整体干净但不再单调
  // ============================================================
  "tokenColors": [
    // ---------- 注释：MATLAB 经典绿色 ----------
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#008013"
      }
    },

    // ---------- 关键字：分两个层次，控制流 vs 声明 ----------
    {
      "name": "Keywords — Control",
      "scope": [
        "keyword.control",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.flow",
        "keyword.control.return",
        "keyword.control.exception"
      ],
      "settings": { "foreground": "#1656A7" }
    },
    {
      "name": "Keywords — General & Storage",
      "scope": [
        "keyword", "storage.type", "storage.modifier",
        "keyword.declaration", "keyword.package.go", "keyword.import.go",
        "keyword.function.go", "keyword.type.go", "keyword.struct.go",
        "keyword.interface.go", "keyword.map.go", "keyword.chan.go"
      ],
      "settings": { "foreground": "#0033CC" }
    },

    // ---------- 函数：暖橙色，灵感来自终端 brightYellow ----------
    {
      "name": "Functions",
      "scope": [
        "entity.name.function", "support.function", "variable.function",
        "entity.name.function.go", "entity.name.function.call"
      ],
      "settings": { "foreground": "#C04C0B" }
    },

    // ---------- 方法/成员函数：深青蓝 ----------
    {
      "name": "Methods",
      "scope": [
        "entity.name.function.member", "support.function.member"
      ],
      "settings": { "foreground": "#0054A6" }
    },

    // ---------- 类型：海绿色 ----------
    {
      "name": "Types",
      "scope": [
        "entity.name.type", "support.type", "storage.type.primitive",
        "entity.name.type.alias.go", "entity.name.type.struct.go",
        "entity.name.type.interface.go", "entity.name.class",
        "entity.name.type.class", "support.class"
      ],
      "settings": { "foreground": "#2E8B57" }
    },

    // ---------- HTML/JSX 标签名：终端青色 ----------
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag", "entity.name.tag.html",
        "entity.name.tag.jsx", "entity.name.tag.tsx",
        "entity.name.tag.xml", "entity.name.tag.css"
      ],
      "settings": { "foreground": "#027880" }
    },

    // ---------- 组件/JSX 大写标签：深青 ----------
    {
      "name": "Component Tags",
      "scope": [
        "entity.name.tag.js", "entity.name.tag.ts",
        "entity.name.tag.javascript", "entity.name.tag.typescript",
        "support.class.component"
      ],
      "settings": { "foreground": "#007095" }
    },

    // ---------- 属性名（HTML 属性/JSON key）：青蓝色 ----------
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.jsx",
        "entity.other.attribute-name.tsx"
      ],
      "settings": { "foreground": "#027880" }
    },

    // ---------- 字符串：MATLAB 经典紫色 ----------
    {
      "name": "Strings",
      "scope": "string",
      "settings": { "foreground": "#A709F5" }
    },

    // ---------- 常量 / 数字：金棕色 ----------
    {
      "name": "Constants",
      "scope": [
        "constant.numeric", "constant.language", "constant.boolean",
        "variable.other.enummember"
      ],
      "settings": { "foreground": "#8B6606" }
    },

    // ---------- 正则表达式：终端亮红 ----------
    {
      "name": "Regex",
      "scope": [
        "string.regexp", "constant.other.character-class.regexp",
        "keyword.control.anchor.regexp"
      ],
      "settings": { "foreground": "#E11B14" }
    },

    // ---------- 转义序列：深金 ----------
    {
      "name": "Escape",
      "scope": "constant.character.escape",
      "settings": { "foreground": "#C04C0B" }
    },

    // ---------- 变量：默认深灰 ----------
    {
      "name": "Variable",
      "scope": ["variable", "variable.parameter", "variable.other.member"],
      "settings": { "foreground": "#212121" }
    },

    // ---------- 变量（共享作用域/属性）：青绿色 ----------
    {
      "name": "Variable Shared Scope",
      "scope": ["variable.readwrite", "variable.other.property"],
      "settings": { "foreground": "#027880" }
    },

    // ---------- 对象属性名：深青 ----------
    {
      "name": "Object Property",
      "scope": [
        "variable.object.property", "variable.other.object.property",
        "support.variable.property"
      ],
      "settings": { "foreground": "#007095" }
    },

    // ---------- this / self / super：深蓝 ----------
    {
      "name": "Language Variable",
      "scope": ["variable.language", "variable.language.this", "variable.language.super"],
      "settings": { "foreground": "#0054A6", "fontStyle": "italic" }
    },

    // ---------- 内置函数/常量：终端青 ----------
    {
      "name": "Built-in",
      "scope": ["support.function.builtin", "support.constant"],
      "settings": { "foreground": "#027880" }
    },

    // ---------- 预处理/导入：同类型色 ----------
    {
      "name": "Preprocessor",
      "scope": ["meta.preprocessor", "keyword.control.import", "keyword.control.export"],
      "settings": { "foreground": "#2E8B57" }
    },

    // ---------- 错误/非法 ----------
    {
      "name": "Warning",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#E11B14" }
    },

    // ---------- 操作符 ----------
    {
      "name": "Operator",
      "scope": "keyword.operator",
      "settings": { "foreground": "#212121" }
    },

    // ---------- 标点 ----------
    {
      "name": "Punctuation",
      "scope": ["punctuation", "punctuation.separator", "punctuation.definition"],
      "settings": { "foreground": "#555555" }
    },

    // ---------- JSON 专属 ----------
    {
      "name": "JSON Property Key",
      "scope": "support.type.property-name.json",
      "settings": { "foreground": "#027880" }
    },
    {
      "name": "JSON Constant",
      "scope": "constant.language.json",
      "settings": { "foreground": "#8B6606" }
    },

    // ---------- YAML 专属 ----------
    {
      "name": "YAML Key",
      "scope": "entity.name.tag.yaml",
      "settings": { "foreground": "#027880" }
    },
    {
      "name": "YAML Constant",
      "scope": ["constant.language.yaml", "constant.numeric.yaml", "constant.other.timestamp.yaml"],
      "settings": { "foreground": "#C04C0B" }
    },
    {
      "name": "YAML String",
      "scope": "string.yaml",
      "settings": { "foreground": "#A709F5" }
    },
    {
      "name": "YAML Anchor & Alias",
      "scope": ["variable.other.anchor.yaml", "variable.other.alias.yaml"],
      "settings": { "foreground": "#8B6606" }
    },
    {
      "name": "YAML Punctuation",
      "scope": ["punctuation.definition.mapping.yaml", "punctuation.definition.sequence.yaml", "punctuation.definition.string.yaml"],
      "settings": { "foreground": "#555555" }
    },

    // ---------- SQL 专属 ----------
    {
      "name": "SQL Keyword",
      "scope": ["keyword.sql", "keyword.ddl.sql", "keyword.dml.sql"],
      "settings": { "foreground": "#0033CC" }
    },
    {
      "name": "SQL Built-in Function",
      "scope": "support.function.sql",
      "settings": { "foreground": "#C04C0B" }
    },
    {
      "name": "SQL Table Name",
      "scope": "entity.name.table.sql",
      "settings": { "foreground": "#2E8B57" }
    },
    {
      "name": "SQL Column Name",
      "scope": "entity.name.column.sql",
      "settings": { "foreground": "#212121" }
    },

    // ---------- Markdown 专属 ----------
    {
      "name": "Markdown Heading",
      "scope": ["markup.heading", "entity.name.section.markdown"],
      "settings": { "foreground": "#0054A6", "fontStyle": "bold" }
    },
    {
      "name": "Markdown Bold",
      "scope": "markup.bold",
      "settings": { "foreground": "#0033CC", "fontStyle": "bold" }
    },
    {
      "name": "Markdown Italic",
      "scope": "markup.italic",
      "settings": { "foreground": "#008013", "fontStyle": "italic" }
    },
    {
      "name": "Markdown Link URL",
      "scope": "markup.link.url",
      "settings": { "foreground": "#1171BE", "fontStyle": "underline" }
    },
    {
      "name": "Markdown Link Text",
      "scope": "string.other.link.title.markdown",
      "settings": { "foreground": "#027880" }
    },
    {
      "name": "Markdown Quote",
      "scope": "markup.quote",
      "settings": { "foreground": "#008013" }
    },
    {
      "name": "Markdown Code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": { "foreground": "#8B6606" }
    },
    {
      "name": "Markdown List Bullet",
      "scope": "punctuation.definition.list.markdown",
      "settings": { "foreground": "#C04C0B" }
    }
  ]
}
