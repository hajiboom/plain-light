{
  "$schema": "vscode://schemas/color-theme",
  "name": "simple-light",
  "type": "light",
  "colors": {
    // ========== 全局：边框 & 景深系统 ==========
    // 设计思路：编辑器是离用户最近的"主面板"（最亮白），
    // 侧边栏/面板/状态栏逐层后退（渐暗），
    // 面板之间的灰色接缝线模拟阴影缝隙，制造立体感。
    "contrastBorder": "#d0d0d0",
    "focusBorder": "#007894",
    "widget.shadow": "#00000012",

    // ---- 编辑器核心：最亮 = 离用户最近 ----
    "editor.background": "#fafafa",
    "editor.foreground": "#242424",
    "editorLineNumber.foreground": "#9e9e9e",
    "editorLineNumber.activeForeground": "#242424",
    "editor.lineHighlightBackground": "#f0f0f0",
    "editor.selectionBackground": "#d6e4ff",
    "editor.selectionHighlightBackground": "#e8f0ff",
    "editorCursor.foreground": "#234ebb",
    "editorWhitespace.foreground": "#e0e0e0",
    "editorIndentGuide.background1": "#e8e8e8",
    "editorIndentGuide.activeBackground1": "#c8c8c8",
    "editorRuler.foreground": "#e8e8e880",
    "editorBracketMatch.background": "#e8f0ff",
    "editorBracketMatch.border": "#1546c1",
    "editor.findMatchBackground": "#fff3cd",
    "editor.findMatchHighlightBackground": "#fff3cd80",

    // ---- 侧边栏：第二层，灰色接缝制造内凹感 ----
    "sideBar.background": "#f2f2f2",
    "sideBar.foreground": "#242424",
    "sideBarSectionHeader.background": "#e8e8e8",
    "sideBarSectionHeader.foreground": "#242424",
    "sideBarTitle.foreground": "#242424",
    "sideBar.border": "#d0d0d0",

    // ---- 活动栏：最深层 = 最远，顶部用细浅灰线分隔 ----
    "activityBar.background": "#e8e8e8",
    "activityBar.foreground": "#242424",
    "activityBar.inactiveForeground": "#9e9e9e",
    "activityBar.border": "#d0d0d0",
    "activityBar.activeBorder": "#0e69b3",
    "activityBar.activeBackground": "#f2f2f2",

    // ========== 顶部标题栏 Go 青蓝 —— 完全保留，不做任何修改 ==========
    "titleBar.activeBackground": "#007894",
    "titleBar.activeForeground": "#ffffff",
    "titleBar.inactiveBackground": "#005c72",
    "titleBar.inactiveForeground": "#f2f2f2",
    "titleBar.border": "#006982",

    // ---- 菜单栏独立于标题栏，清晰边框 ----
    "menu.background": "#ffffff",
    "menu.foreground": "#242424",
    "menu.selectionBackground": "#d6e4ff",
    "menu.selectionForeground": "#242424",
    "menu.border": "#d0d0d0",

    // ---- 底部状态栏：深层，顶部接缝分隔 ----
    "statusBar.background": "#e8e8e8",
    "statusBar.foreground": "#242424",
    "statusBar.border": "#d0d0d0",
    "statusBar.debuggingBackground": "#f5e0d0",

    // ---- 面板 / 终端：第二层，顶部灰色接缝分隔 ----
    "panel.background": "#f2f2f2",
    "panel.border": "#d0d0d0",
    "panelTitle.activeForeground": "#242424",
    "panelTitle.inactiveForeground": "#9e9e9e",

    "terminal.background": "#f2f2f2",
    "terminal.foreground": "#242424",
    "terminal.ansiBlack": "#1a1a1a",
    "terminal.ansiRed": "#b02b3d",
    "terminal.ansiGreen": "#216e39",
    "terminal.ansiYellow": "#b87333",
    "terminal.ansiBlue": "#0033b3",
    "terminal.ansiMagenta": "#8828a0",
    "terminal.ansiCyan": "#007095",
    "terminal.ansiWhite": "#c8c8c8",
    "terminal.ansiBrightBlack": "#777777",
    "terminal.ansiBrightRed": "#d13a4f",
    "terminal.ansiBrightGreen": "#2e9e4a",
    "terminal.ansiBrightYellow": "#d9923b",
    "terminal.ansiBrightBlue": "#1a56db",
    "terminal.ansiBrightMagenta": "#a035c2",
    "terminal.ansiBrightCyan": "#0090b8",
    "terminal.ansiBrightWhite": "#f0f0f0",

    // ---- 列表 / 树：清晰选中边框 ----
    "list.activeSelectionBackground": "#d6e4ff",
    "list.activeSelectionForeground": "#242424",
    "list.inactiveSelectionBackground": "#e8e8e8",
    "list.inactiveSelectionForeground": "#242424",
    "list.hoverBackground": "#eeeeee",
    "list.hoverForeground": "#242424",
    "list.focusBackground": "#d6e4ff",
    "list.focusForeground": "#242424",
    "list.highlightForeground": "#007894",

    // ---- 输入框 / 下拉：凸起控件的边框 ----
    "input.background": "#ffffff",
    "input.foreground": "#242424",
    "input.border": "#c8c8c8",
    "input.placeholderForeground": "#9e9e9e",
    "inputOption.activeBorder": "#007894",
    "dropdown.background": "#ffffff",
    "dropdown.foreground": "#242424",
    "dropdown.border": "#c8c8c8",

    // ---- 按钮：微凸起 ----
    "button.background": "#e0e0e0",
    "button.foreground": "#242424",
    "button.hoverBackground": "#d0d0d0",
    "button.border": "#c8c8c8",

    // ---- 滚动条：立体滑块 ----
    "scrollbarSlider.background": "#d0d0d0",
    "scrollbarSlider.hoverBackground": "#c0c0c0",
    "scrollbarSlider.activeBackground": "#b0b0b0",

    // ---- 标签栏：接缝线 + 激活标签的蓝色顶部边框 ----
    "editorGroup.border": "#d0d0d0",
    "editorGroupHeader.tabsBackground": "#f2f2f2",
    "editorGroupHeader.border": "#d0d0d0",
    "tab.activeBackground": "#fafafa",
    "tab.inactiveBackground": "#f2f2f2",
    "tab.activeForeground": "#000000",
    "tab.inactiveForeground": "#555555",
    "tab.border": "#d0d0d0",
    "tab.activeBorder": "#007894",
    "tab.activeBorderTop": "#007894",
    "tab.unfocusedActiveBorderTop": "#d0d0d0",

    // ---- 提示/通知：浮层立体感 ----
    "notifications.background": "#ffffff",
    "notifications.foreground": "#242424",

    // ---- 其他：编辑器浮层阴影 ----
    "badge.background": "#007894",
    "badge.foreground": "#ffffff",
    "progressBar.background": "#007894",
    "editorWidget.background": "#ffffff",
    "editorWidget.border": "#c8c8c8",
    "editorSuggestWidget.background": "#ffffff",
    "editorSuggestWidget.border": "#c8c8c8",
    "editorSuggestWidget.selectedBackground": "#e8f0ff",
    "editorHoverWidget.background": "#ffffff",
    "editorHoverWidget.border": "#c8c8c8",
    "list.activeSelectionIconForeground": "#ffffff"
  },

  // ========== 代码高亮：针对浅色背景全面优化 ==========
  // 灵感来自 GitHub Light / IntelliJ Light，强调色彩对比度和可读性
  "tokenColors": [
    // ---------- 通用基础高亮 ----------
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#6a737d"
      }
    },

    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.declaration",
        "keyword.package.go",
        "keyword.import.go",
        "keyword.function.go",
        "keyword.type.go",
        "keyword.struct.go",
        "keyword.interface.go",
        "keyword.map.go",
        "keyword.chan.go"
      ],
      "settings": {
        "foreground": "#0033b3"
      }
    },

    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "entity.name.function.go"
      ],
      "settings": {
        "foreground": "#6f42c1"
      }
    },

    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "support.type",
        "storage.type.primitive",
        "entity.name.type.alias.go",
        "entity.name.type.struct.go",
        "entity.name.type.interface.go"
      ],
      "settings": {
        "foreground": "#0550ae"
      }
    },

    {
      "name": "Strings",
      "scope": "string",
      "settings": {
        "foreground": "#1a7f37"
      }
    },

    {
      "name": "Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.boolean",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#953800"
      }
    },

    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other.member"
      ],
      "settings": {
        "foreground": "#383838"
      }
    },

    {
      "name": "Built-in",
      "scope": [
        "support.function.builtin",
        "support.constant"
      ],
      "settings": {
        "foreground": "#0969da"
      }
    },

    {
      "name": "Preprocessor",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#6f42c1"
      }
    },

    {
      "name": "Warning",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#cf222e"
      }
    },

    {
      "name": "Operator",
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#242424"
      }
    },

    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.definition"
      ],
      "settings": {
        "foreground": "#444444"
      }
    },

    // ---------- JSON 文件专属高亮 ----------
    {
      "name": "JSON Property Key",
      "scope": "support.type.property-name.json",
      "settings": {
        "foreground": "#0550ae"
      }
    },
    {
      "name": "JSON Constant",
      "scope": "constant.language.json",
      "settings": {
        "foreground": "#cf222e"
      }
    },

    // ---------- YAML 文件专属高亮 ----------
    {
      "name": "YAML Key",
      "scope": "entity.name.tag.yaml",
      "settings": {
        "foreground": "#0550ae"
      }
    },
    {
      "name": "YAML Constant",
      "scope": [
        "constant.language.yaml",
        "constant.numeric.yaml",
        "constant.other.timestamp.yaml"
      ],
      "settings": {
        "foreground": "#953800"
      }
    },
    {
      "name": "YAML String",
      "scope": "string.yaml",
      "settings": {
        "foreground": "#1a7f37"
      }
    },
    {
      "name": "YAML Anchor & Alias",
      "scope": [
        "variable.other.anchor.yaml",
        "variable.other.alias.yaml"
      ],
      "settings": {
        "foreground": "#0033b3"
      }
    },
    {
      "name": "YAML Punctuation",
      "scope": [
        "punctuation.definition.mapping.yaml",
        "punctuation.definition.sequence.yaml",
        "punctuation.definition.string.yaml"
      ],
      "settings": {
        "foreground": "#444444"
      }
    },

    // ---------- SQL 文件专属高亮 ----------
    {
      "name": "SQL Keyword",
      "scope": [
        "keyword.sql",
        "keyword.ddl.sql",
        "keyword.dml.sql"
      ],
      "settings": {
        "foreground": "#0033b3"
      }
    },
    {
      "name": "SQL Built-in Function",
      "scope": "support.function.sql",
      "settings": {
        "foreground": "#0969da"
      }
    },
    {
      "name": "SQL Table Name",
      "scope": "entity.name.table.sql",
      "settings": {
        "foreground": "#0550ae"
      }
    },
    {
      "name": "SQL Column Name",
      "scope": "entity.name.column.sql",
      "settings": {
        "foreground": "#383838"
      }
    },

    // ---------- Markdown 文件专属高亮 ----------
    {
      "name": "Markdown Heading",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#0550ae",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Bold",
      "scope": "markup.bold",
      "settings": {
        "foreground": "#1f2328",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Italic",
      "scope": "markup.italic",
      "settings": {
        "foreground": "#1f2328",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Link URL",
      "scope": "markup.link.url",
      "settings": {
        "foreground": "#1a7f37",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown Link Text",
      "scope": "string.other.link.title.markdown",
      "settings": {
        "foreground": "#0969da"
      }
    },
    {
      "name": "Markdown Quote",
      "scope": "markup.quote",
      "settings": {
        "foreground": "#6a737d"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#953800"
      }
    },
    {
      "name": "Markdown List Bullet",
      "scope": "punctuation.definition.list.markdown",
      "settings": {
        "foreground": "#cf222e"
      }
    }
  ]
}
