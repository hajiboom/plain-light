{
  "$schema": "vscode://schemas/color-theme",
  "name": "simple-light",
  "type": "light",
  "colors": {
    // ============================================================
    // 全局基调：Debian vim/emacs 纯白底
    // 标题栏与底部状态栏保留 go.dev 藏蓝 (#007894)
    // ============================================================
    "contrastBorder": "#d4d4d4",
    "focusBorder": "#007894",
    "widget.shadow": "#00000010",

    // ---- 编辑器核心：纯白底，黑字 ----
    "editor.background": "#ffffff",
    "editor.foreground": "#000000",
    "editorLineNumber.foreground": "#9e9e9e",
    "editorLineNumber.activeForeground": "#007894",
    "editor.lineHighlightBackground": "#f2f2f2",
    "editor.selectionBackground": "#cce4ff",
    "editor.selectionHighlightBackground": "#e6e6e680",
    "editorCursor.foreground": "#007894",
    "editorWhitespace.foreground": "#dcdcdc",
    "editorIndentGuide.background1": "#e6e6e6",
    "editorIndentGuide.activeBackground1": "#b0b0b0",
    "editorRuler.foreground": "#e0e0e0",
    "editorBracketMatch.background": "#e8e8e8",
    "editorBracketMatch.border": "#007894",
    "editor.findMatchBackground": "#FDE3A7",
    "editor.findMatchHighlightBackground": "#FDE3A780",

    // ---- Git 变更提示 ----
    "editorGutter.addedBackground": "#388E3C",
    "editorGutter.modifiedBackground": "#1976D2",
    "editorGutter.deletedBackground": "#E11B14",
    "minimapGutter.addedBackground": "#388E3C",
    "minimapGutter.modifiedBackground": "#1976D2",
    "minimapGutter.deletedBackground": "#E11B14",
    "editorOverviewRuler.addedForeground": "#388E3C",
    "editorOverviewRuler.modifiedForeground": "#1976D2",
    "editorOverviewRuler.deletedForeground": "#E11B14",
    "gitDecoration.addedResourceForeground": "#388E3C",
    "gitDecoration.modifiedResourceForeground": "#1976D2",
    "gitDecoration.deletedResourceForeground": "#E11B14",
    "gitDecoration.untrackedResourceForeground": "#8B6606",
    "gitDecoration.ignoredResourceForeground": "#9e9e9e",

    // ---- 侧边栏：浅灰 ----
    "sideBar.background": "#f3f3f3",
    "sideBar.foreground": "#000000",
    "sideBarSectionHeader.background": "#ececec",
    "sideBarSectionHeader.foreground": "#000000",
    "sideBarTitle.foreground": "#000000",
    "sideBar.border": "#dcdcdc",

    // ---- 活动栏 ----
    "activityBar.background": "#ececec",
    "activityBar.foreground": "#000000",
    "activityBar.inactiveForeground": "#9e9e9e",
    "activityBar.border": "#dcdcdc",
    "activityBar.activeBorder": "#007894",
    "activityBar.activeBackground": "#f3f3f3",

    // ========== 标题栏：保留 go.dev 藏蓝 ==========
    "titleBar.activeBackground": "#007894",
    "titleBar.activeForeground": "#ffffff",
    "titleBar.inactiveBackground": "#005c72",
    "titleBar.inactiveForeground": "#d9d9d9",
    "titleBar.border": "#006982",

    // ---- 命令中心（新版 VSCode 编辑器顶部） ----
    "commandCenter.foreground": "#000000",
    "commandCenter.activeForeground": "#007894",
    "commandCenter.inactiveForeground": "#9e9e9e",
    "commandCenter.background": "#f3f3f3",
    "commandCenter.activeBackground": "#ececec",
    "commandCenter.border": "#dcdcdc",
    "commandCenter.inactiveBorder": "#dcdcdc80",
    "commandCenter.debuggingBackground": "#B3620580",

    // ---- 菜单栏 ----
    "menu.background": "#f3f3f3",
    "menu.foreground": "#000000",
    "menu.selectionBackground": "#cce4ff",
    "menu.selectionForeground": "#000000",
    "menu.border": "#b8b8b8",

    // ========== 底部状态栏：保留 go.dev 藏蓝 ==========
    "statusBar.background": "#007894",
    "statusBar.foreground": "#ffffff",
    "statusBar.border": "#006982",
    "statusBar.debuggingBackground": "#B36205",
    "statusBar.debuggingForeground": "#ffffff",
    "statusBar.noFolderBackground": "#007894",
    "statusBar.focusBorder": "#40b8d8",
    "statusBarItem.remoteBackground": "#007894",
    "statusBarItem.remoteForeground": "#ffffff",
    "statusBarItem.warningBackground": "#B36205",
    "statusBarItem.warningForeground": "#ffffff",
    "statusBarItem.errorBackground": "#C72824",
    "statusBarItem.errorForeground": "#ffffff",

    // ---- 面板 / 终端：纯白，贴近原生终端 ----
    "panel.background": "#f3f3f3",
    "panel.border": "#dcdcdc",
    "panelTitle.activeForeground": "#007894",
    "panelTitle.inactiveForeground": "#9e9e9e",

    "terminal.background": "#ffffff",
    "terminal.foreground": "#000000",
    "terminal.selectionBackground": "#cce4ff80",
    "terminalCursor.foreground": "#007894",
    "terminal.ansiBlack": "#000000",
    "terminal.ansiRed": "#cd3131",
    "terminal.ansiGreen": "#00bc00",
    "terminal.ansiYellow": "#949800",
    "terminal.ansiBlue": "#0451a5",
    "terminal.ansiMagenta": "#bc05bc",
    "terminal.ansiCyan": "#0598bc",
    "terminal.ansiWhite": "#555555",
    "terminal.ansiBrightBlack": "#666666",
    "terminal.ansiBrightRed": "#cd3131",
    "terminal.ansiBrightGreen": "#14ce14",
    "terminal.ansiBrightYellow": "#b5ba00",
    "terminal.ansiBrightBlue": "#0451a5",
    "terminal.ansiBrightMagenta": "#bc05bc",
    "terminal.ansiBrightCyan": "#0598bc",
    "terminal.ansiBrightWhite": "#a5a5a5",

    // ---- 列表 / 树 ----
    "list.activeSelectionBackground": "#cce4ff",
    "list.activeSelectionForeground": "#000000",
    "list.inactiveSelectionBackground": "#f0f0f0",
    "list.inactiveSelectionForeground": "#000000",
    "list.hoverBackground": "#f0f0f0",
    "list.hoverForeground": "#000000",
    "list.focusBackground": "#cce4ff",
    "list.focusForeground": "#000000",
    "list.highlightForeground": "#000080",

    // ---- 输入框 / 下拉 ----
    "input.background": "#ffffff",
    "input.foreground": "#000000",
    "input.border": "#d4d4d4",
    "input.placeholderForeground": "#9e9e9e",
    "inputOption.activeBorder": "#007894",
    "dropdown.background": "#ffffff",
    "dropdown.foreground": "#000000",
    "dropdown.border": "#d4d4d4",

    // ---- 按钮：保留 go 藏蓝 ----
    "button.background": "#007894",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#0090B8",
    "button.border": "#006982",

    // ---- 滚动条 ----
    "scrollbarSlider.background": "#c0c0c080",
    "scrollbarSlider.hoverBackground": "#9e9e9e80",
    "scrollbarSlider.activeBackground": "#00789480",

    // ---- 标签栏 ----
    "editorGroup.border": "#dcdcdc",
    "editorGroupHeader.tabsBackground": "#f3f3f3",
    "editorGroupHeader.border": "#dcdcdc",
    "tab.activeBackground": "#ffffff",
    "tab.inactiveBackground": "#f3f3f3",
    "tab.activeForeground": "#000000",
    "tab.inactiveForeground": "#555555",
    "tab.border": "#dcdcdc",
    "tab.activeBorder": "#007894",
    "tab.activeBorderTop": "#007894",
    "tab.unfocusedActiveBorderTop": "#dcdcdc",

    // ---- 通知 ----
    "notifications.background": "#ffffff",
    "notifications.foreground": "#000000",
    "notificationsWarningIcon.foreground": "#B36205",
    "notificationsErrorIcon.foreground": "#E11B14",
    "notificationsInfoIcon.foreground": "#1656A7",

    // ---- 浮层 / 建议框 ----
    "badge.background": "#007894",
    "badge.foreground": "#ffffff",
    "progressBar.background": "#007894",
    "editorWidget.background": "#ffffff",
    "editorWidget.border": "#d4d4d4",
    "editorSuggestWidget.background": "#ffffff",
    "editorSuggestWidget.border": "#d4d4d4",
    "editorSuggestWidget.selectedBackground": "#cce4ff",
    "editorHoverWidget.background": "#ffffff",
    "editorHoverWidget.border": "#d4d4d4",
    "list.activeSelectionIconForeground": "#007894",

    // ---- 内联聊天 / Chat（新版 VSCode） ----
    "inlineChat.background": "#f7f7f7",
    "inlineChat.foreground": "#000000",
    "inlineChat.border": "#dcdcdc",
    "inlineChatInput.background": "#ffffff",
    "inlineChatInput.border": "#d4d4d4",
    "inlineChatInput.focusBorder": "#007894",
    "chat.requestBackground": "#f3f3f3",
    "chat.requestBorder": "#dcdcdc",
    "chat.slashCommandBackground": "#e0eef7",
    "chat.slashCommandForeground": "#007894",
    "chat.editedFileForeground": "#8B6606"
  },

  // ============================================================
  // 代码高亮：极简四色 —
  // 藏蓝关键字、暗红字符串、灰绿注释、暗绿常量，
  // 函数 / 类型 / 变量等自定义标识符保持纯黑原色
  // ============================================================
  "tokenColors": [
    // ---------- 注释：灰绿斜体 ----------
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#608b4e"
      }
    },

    // ---------- 关键字：藏蓝（含内置类型 / 修饰符） ----------
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.flow",
        "keyword.control.return",
        "keyword.control.exception",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.declaration",
        "keyword.package.go", "keyword.import.go",
        "keyword.function.go", "keyword.type.go", "keyword.struct.go",
        "keyword.interface.go", "keyword.map.go", "keyword.chan.go",
        "storage.type", "storage.modifier"
      ],
      "settings": { "foreground": "#005c72" }
    },

    // ---------- 预处理指令：深藏蓝 ----------
    {
      "name": "Preprocessor",
      "scope": "meta.preprocessor",
      "settings": { "foreground": "#000080" }
    },

    // ---------- HTML/JSX 标签名：藏蓝 ----------
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "support.class.component"],
      "settings": { "foreground": "#000080" }
    },

    // ---------- 属性名 / JSON key / YAML key：藏蓝 ----------
    {
      "name": "Attributes & Keys",
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name.json",
        "entity.name.tag.yaml"
      ],
      "settings": { "foreground": "#000080" }
    },

    // ---------- 字符串：暗红 ----------
    {
      "name": "Strings",
      "scope": "string",
      "settings": { "foreground": "#a31515" }
    },

    // ---------- 函数名：暖灰，与普通文本黑色区分 ----------
    {
      "name": "Function",
      "scope": [
        "entity.name.function", "support.function", "variable.function"
      ],
      "settings": { "foreground": "#6b6252" }
    },

    // ---------- 数字 / 布尔 / 常量：暗绿 ----------
    {
      "name": "Constants",
      "scope": [
        "constant.numeric", "constant.language", "constant.boolean",
        "variable.other.enummember"
      ],
      "settings": { "foreground": "#098658" }
    },

    // ---------- 转义序列：暗绿 ----------
    {
      "name": "Escape",
      "scope": "constant.character.escape",
      "settings": { "foreground": "#098658" }
    },

    // ---------- this / self / super：仅斜体，不换色 ----------
    {
      "name": "Language Variable",
      "scope": ["variable.language", "variable.language.this", "variable.language.super"],
      "settings": { "fontStyle": "italic" }
    },

    // ---------- 错误 / 非法 ----------
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#cd3131" }
    },

    // ---------- Markdown ----------
    {
      "name": "Markdown Heading",
      "scope": ["markup.heading", "entity.name.section.markdown"],
      "settings": { "foreground": "#000080", "fontStyle": "bold" }
    },
    {
      "name": "Markdown Bold",
      "scope": "markup.bold",
      "settings": { "fontStyle": "bold" }
    },
    {
      "name": "Markdown Italic",
      "scope": "markup.italic",
      "settings": { "fontStyle": "italic" }
    },
    {
      "name": "Markdown Quote",
      "scope": "markup.quote",
      "settings": { "foreground": "#608b4e", "fontStyle": "italic" }
    },
    {
      "name": "Markdown Code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": { "foreground": "#098658" }
    },
    {
      "name": "Markdown Link",
      "scope": ["markup.link.url", "markup.underline.link"],
      "settings": { "foreground": "#007894", "fontStyle": "underline" }
    }
  ]
}
