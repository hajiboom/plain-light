{
  "$schema": "vscode://schemas/color-theme",
  "name": "Vinci Dark (Warm)",
  "type": "dark",
  "colors": {
    // ========== 全局：边框 & 景深系统 ==========
    // 设计思路：编辑器是离用户最近的"主面板"（最亮），
    // 侧边栏/面板/状态栏逐层后退（渐暗），
    // 面板之间的深色接缝线模拟"阴影缝隙"，制造立体感。
    "contrastBorder": "#3d3d3d",
    "focusBorder": "#606060",
    "widget.shadow": "#00000060",

    // ---- 编辑器核心：最亮 = 离用户最近的主工作面 ----
    "editor.background": "#2c2c2c",
    "editor.foreground": "#e1e1e1",
    "editor.lineHighlightBackground": "#343434",
    "editor.selectionBackground": "#454545",
    "editor.selectionHighlightBackground": "#3d3d3d",
    "editorCursor.foreground": "#82A8D9",
    "editorWhitespace.foreground": "#3d3d3d",
    "editorIndentGuide.background1": "#343434",
    "editorIndentGuide.activeBackground1": "#555555",
    "editorLineNumber.foreground": "#6a6a6a",
    "editorLineNumber.activeForeground": "#cccccc",
    "editorRuler.foreground": "#34343480",
    "editorBracketMatch.background": "#383838",
    "editorBracketMatch.border": "#82A8D9",
    "editor.findMatchBackground": "#45454560",
    "editor.findMatchHighlightBackground": "#3d3d3d60",

    // ---- 侧边栏：第二层，比编辑器暗 = 内凹 ----
    // 右边框用 #151515 形成深色接缝，视觉上把侧边栏"推远"
    "sideBar.background": "#252525",
    "sideBar.foreground": "#cccccc",
    "sideBarSectionHeader.background": "#1e1e1e",
    "sideBarSectionHeader.foreground": "#cccccc",
    "sideBarTitle.foreground": "#cccccc",
    "sideBar.border": "#151515",

    // ---- 活动栏：最深层 = 最远 ----
    "activityBar.background": "#1e1e1e",
    "activityBar.foreground": "#cccccc",
    "activityBar.inactiveForeground": "#6a6a6a",
    "activityBar.border": "#151515",
    "activityBar.activeBorder": "#82A8D9",
    "activityBar.activeBackground": "#252525",

    // ---- 底部状态栏：深层，顶部接缝线分隔 ----
    "statusBar.background": "#1e1e1e",
    "statusBar.foreground": "#cccccc",
    "statusBar.border": "#151515",
    "statusBar.noFolderBackground": "#1e1e1e",
    "statusBar.debuggingBackground": "#1e1e1e",

    // ========== 顶部标题栏 Go 蓝色 —— 完全保留，不做任何修改 ==========
    "titleBar.activeBackground": "#007894",
    "titleBar.activeForeground": "#ffffff",
    "titleBar.inactiveBackground": "#005c72",
    "titleBar.inactiveForeground": "#d0d0d0",
    "titleBar.border": "#006982",

    // ---- 顶部菜单栏 沿用旧版，与标题栏一体 ----
    "menu.background": "#006982",
    "menu.foreground": "#ffffff",
    "menu.selectionBackground": "#007894",
    "menu.selectionForeground": "#ffffff",
    "menu.border": "#005c72",

    // ---- 面板 / 终端：第二层，顶部深色接缝分隔 ----
    "panel.background": "#252525",
    "panel.border": "#151515",
    "panelTitle.activeForeground": "#cccccc",
    "panelTitle.inactiveForeground": "#6a6a6a",

    "terminal.background": "#2c2c2c",
    "terminal.foreground": "#e1e1e1",
    "terminal.selectionBackground": "#454545",
    "terminalCursor.foreground": "#82A8D9",
    "terminal.ansiBlack": "#1a1a1a",
    "terminal.ansiRed": "#b02b3d",
    "terminal.ansiGreen": "#5ea832",
    "terminal.ansiYellow": "#e6c72e",
    "terminal.ansiBlue": "#82A8D9",
    "terminal.ansiMagenta": "#a066b8",
    "terminal.ansiCyan": "#60b8d8",
    "terminal.ansiWhite": "#d8d8d8",
    "terminal.ansiBrightBlack": "#666666",
    "terminal.ansiBrightRed": "#d13a4f",
    "terminal.ansiBrightGreen": "#73c936",
    "terminal.ansiBrightYellow": "#ffdd33",
    "terminal.ansiBrightBlue": "#96a6c8",
    "terminal.ansiBrightMagenta": "#b87ad0",
    "terminal.ansiBrightCyan": "#7fd0e8",
    "terminal.ansiBrightWhite": "#f0f0f0",

    // ---- 列表/树：选中高亮醒目蓝，边框分隔 ----
    "list.activeSelectionBackground": "#2d5a9c",
    "list.activeSelectionForeground": "#ffffff",
    "list.inactiveSelectionBackground": "#333333",
    "list.inactiveSelectionForeground": "#cccccc",
    "list.hoverBackground": "#363636",
    "list.hoverForeground": "#e8e8e8",
    "list.focusBackground": "#2d5a9c",
    "list.focusForeground": "#ffffff",
    "list.highlightForeground": "#52b7d2",

    // ---- 输入框 / 下拉 / 按钮：凸起的控件层 ----
    "input.background": "#333333",
    "input.foreground": "#e1e1e1",
    "input.border": "#3d3d3d",
    "input.placeholderForeground": "#6a6a6a",
    "inputOption.activeBorder": "#82A8D9",
    "dropdown.background": "#333333",
    "dropdown.foreground": "#e1e1e1",
    "dropdown.border": "#3d3d3d",

    "button.background": "#404040",
    "button.foreground": "#e1e1e1",
    "button.hoverBackground": "#4a4a4a",
    "button.border": "#3d3d3d",

    "scrollbarSlider.background": "#404040",
    "scrollbarSlider.hoverBackground": "#4a4a4a",
    "scrollbarSlider.activeBackground": "#555555",

    // ---- 标签栏：深色接缝分隔编辑器区域 ----
    "editorGroup.border": "#151515",
    "editorGroupHeader.tabsBackground": "#252525",
    "editorGroupHeader.border": "#151515",
    "tab.activeBackground": "#2c2c2c",
    "tab.inactiveBackground": "#252525",
    "tab.activeForeground": "#e8e8e8",
    "tab.inactiveForeground": "#999999",
    "tab.border": "#151515",
    "tab.activeBorder": "#007894",
    "tab.activeBorderTop": "#007894",
    "tab.unfocusedActiveBorderTop": "#3d3d3d",

    "notifications.background": "#333333",
    "notifications.foreground": "#e1e1e1",

    "badge.background": "#82A8D9",
    "badge.foreground": "#ffffff",
    "progressBar.background": "#82A8D9",
    "editorWidget.background": "#333333",
    "editorWidget.border": "#3d3d3d",
    "editorSuggestWidget.background": "#333333",
    "editorSuggestWidget.border": "#3d3d3d",
    "editorSuggestWidget.selectedBackground": "#3d3d3d",
    "editorHoverWidget.background": "#333333",
    "editorHoverWidget.border": "#3d3d3d"
  },

  // 【完全原样照搬】tokenColors 语法高亮一分一毫未改动，沿用你长期使用的全套配色
  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#b07a35"
      }
    },

    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.declaration"
      ],
      "settings": {
        "foreground": "#e6c72e"
      }
    },

    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#8a9abc"
      }
    },

    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "support.type",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#889a90"
      }
    },

    {
      "name": "String",
      "scope": "string",
      "settings": {
        "foreground": "#5ea832"
      }
    },

    {
      "name": "Constant",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.boolean"
      ],
      "settings": {
        "foreground": "#889a90"
      }
    },

    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other.member"
      ],
      "settings": {
        "foreground": "#d3d3d5"
      }
    },

    {
      "name": "Built-in",
      "scope": [
        "support.function.builtin",
        "support.constant"
      ],
      "settings": {
        "foreground": "#52b7d2"
      }
    },

    {
      "name": "Preprocessor",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#889a90"
      }
    },

    {
      "name": "Warning",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#f43841"
      }
    },

    {
      "name": "Operator",
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#d8d8d8"
      }
    },

    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.definition"
      ],
      "settings": {
        "foreground": "#cfcece"
      }
    },

    // ---------- JSON 文件专属高亮 ----------
    {
      "name": "JSON Property Key",
      "scope": "support.type.property-name.json",
      "settings": {
        "foreground": "#52b7d2"
      }
    },
    {
      "name": "JSON Constant (true/false/null)",
      "scope": "constant.language.json",
      "settings": {
        "foreground": "#e6c72e"
      }
    },

    // ---------- YAML 文件专属高亮 ----------
    {
      "name": "YAML Key",
      "scope": "entity.name.tag.yaml",
      "settings": {
        "foreground": "#52b7d2"
      }
    },
    {
      "name": "YAML Constant",
      "scope": [
        "constant.language.yaml",
        "constant.numeric.yaml",
        "constant.other.timestamp.yaml"
      ],
      "settings": {
        "foreground": "#889a90"
      }
    },
    {
      "name": "YAML String",
      "scope": "string.yaml",
      "settings": {
        "foreground": "#5ea832"
      }
    },
    {
      "name": "YAML Anchor & Alias",
      "scope": [
        "variable.other.anchor.yaml",
        "variable.other.alias.yaml"
      ],
      "settings": {
        "foreground": "#e6c72e"
      }
    },
    {
      "name": "YAML Punctuation",
      "scope": [
        "punctuation.definition.mapping.yaml",
        "punctuation.definition.sequence.yaml",
        "punctuation.definition.string.yaml"
      ],
      "settings": {
        "foreground": "#cfcece"
      }
    },

    // ---------- SQL 文件专属高亮 ----------
    {
      "name": "SQL Keyword",
      "scope": [
        "keyword.sql",
        "keyword.ddl.sql",
        "keyword.dml.sql"
      ],
      "settings": {
        "foreground": "#e6c72e"
      }
    },
    {
      "name": "SQL Built-in Function",
      "scope": "support.function.sql",
      "settings": {
        "foreground": "#52b7d2"
      }
    },
    {
      "name": "SQL Table Name",
      "scope": "entity.name.table.sql",
      "settings": {
        "foreground": "#889a90"
      }
    },
    {
      "name": "SQL Column Name",
      "scope": "entity.name.column.sql",
      "settings": {
        "foreground": "#d3d3d5"
      }
    },

    // ---------- Markdown 文件专属高亮 ----------
    {
      "name": "Markdown Heading",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#e6c72e",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Bold",
      "scope": "markup.bold",
      "settings": {
        "foreground": "#8a9abc",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Italic",
      "scope": "markup.italic",
      "settings": {
        "foreground": "#b07a35",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Link URL",
      "scope": "markup.link.url",
      "settings": {
        "foreground": "#5ea832",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown Link Text",
      "scope": "string.other.link.title.markdown",
      "settings": {
        "foreground": "#52b7d2"
      }
    },
    {
      "name": "Markdown Quote",
      "scope": "markup.quote",
      "settings": {
        "foreground": "#b07a35"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#5ea832"
      }
    },
    {
      "name": "Markdown List Bullet",
      "scope": "punctuation.definition.list.markdown",
      "settings": {
        "foreground": "#52b7d2"
      }
    }
  ]
}