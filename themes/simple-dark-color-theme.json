{
  "$schema": "vscode://schemas/color-theme",
  "name": "Vinci Dark (Warm)",
  "type": "dark",
  "semanticHighlighting": true,

  // ============================================================
  // 调色板（源自 Tsoding Gruber Darker / Anksio Minimal 移植版，已降亮降饱和）
  //   bg        #181818   编辑区 / 侧栏底色（标题栏为藏蓝）
  //   fg        #c6c6c6   正文（10.4:1；原 #d4d4d4 为 12:1）
  //   yellow    #d8bd55   关键字 / 强调色（峰值亮度 0.52，原 #ffdd33 为 0.73）
  //   green     #7fb757   字符串
  //   comment   #858585   注释（JetBrains Darcula 灰，弱化处理）
  //   orange    #dc7a45   数字（饱和度 68%，原 #ff6200 为 100%）
  //   niagara   #949bb0   函数 / 类名
  //   quartz    #94b0a6   类型 / 常量
  //   attr      #95a2c9   属性 / 链接
  //   quote     #d99f57   引用 / 强调语句
  //   red       #e35d64   错误
  //   sel       #504945   选区 / 选中项
  // ============================================================
  "colors": {
    "foreground": "#b1a69f",
    "focusBorder": "#d8bd55",
    "selection.background": "#504945",
    "widget.shadow": "#000000a0",
    // 焦点/图标色：Gruber 灰 #504945 在 #181818 上只有 2.01:1，图标不可见
    "icon.foreground": "#a6a6a6",
    "contrastBorder": "#444444",

    // ---- 活动栏 ----
    "activityBar.foreground": "#d8bd55",
    "activityBar.background": "#181818",
    "activityBar.inactiveForeground": "#8c8c8c",
    "activityBar.border": "#181818",
    "activityBar.activeBackground": "#181818",
    "activityBar.activeBorder": "#d8bd55",
    "activityBarBadge.foreground": "#d8bd55",
    "activityBarBadge.background": "#504945",

    // ---- 侧边栏 ----
    "sideBar.background": "#181818",
    "sideBar.foreground": "#bfbfbf",
    "sideBar.border": "#80808059",
    "sideBar.dropBackground": "#1d1c1c",
    "sideBarTitle.foreground": "#bbbbbb",
    "sideBarSectionHeader.background": "#181818",
    "sideBarSectionHeader.foreground": "#bfbfbf",
    "sideBarSectionHeader.border": "#504945",

    // ---- 列表 / 树 ----
    "list.activeSelectionBackground": "#2e2d2c",
    "list.activeSelectionForeground": "#e8e8e8",
    "list.inactiveSelectionBackground": "#2e2d2c",
    "list.inactiveSelectionForeground": "#bfbfbf",
    "list.focusBackground": "#504945",
    "list.focusForeground": "#bfbfbf",
    "list.hoverBackground": "#1f1e1e",
    "list.hoverForeground": "#bfbfbf",
    "list.highlightForeground": "#d8bd55",
    "list.dropBackground": "#1d1c1c",
    "listFilterWidget.background": "#181818",
    "listFilterWidget.outline": "#bfbfbf",
    "listFilterWidget.noMatchesOutline": "#be1100",
    "tree.indentGuidesStroke": "#504945",

    // ---- 状态栏 ----
    "statusBar.background": "#141414",
    "statusBar.foreground": "#e8e8e8",
    "statusBar.border": "#181818",
    "statusBar.focusBorder": "#d8bd55",
    "statusBar.noFolderBackground": "#141414",
    "statusBar.noFolderForeground": "#e8e8e8",
    "statusBar.debuggingBackground": "#881111",
    "statusBar.debuggingForeground": "#ffffff",
    "statusBarItem.hoverBackground": "#504945",
    "statusBarItem.activeBackground": "#e8e8e825",
    "statusBarItem.remoteBackground": "#141414",
    "statusBarItem.remoteForeground": "#e8e8e8",

    // ---- 标题栏 / 菜单栏：仅顶部保留标志性 go.dev 藏蓝 ----
    "titleBar.activeBackground": "#007894",
    "titleBar.activeForeground": "#ffffff",
    "titleBar.inactiveBackground": "#005c72",
    "titleBar.inactiveForeground": "#d9d9d9",
    "titleBar.border": "#006982",
    "menubar.selectionForeground": "#bfbfbf",
    "menubar.selectionBackground": "#e8e8e81a",

    // ---- 命令中心 ----
    "commandCenter.background": "#181818",
    "commandCenter.foreground": "#bfbfbf",
    "commandCenter.activeBackground": "#282828",
    "commandCenter.activeForeground": "#d8bd55",
    "commandCenter.inactiveForeground": "#a6a6a6",
    "commandCenter.border": "#504945",
    "commandCenter.inactiveBorder": "#504945",

    // ---- 菜单 ----
    "menu.foreground": "#bfbfbf",
    "menu.background": "#282828",
    "menu.selectionForeground": "#e8e8e8",
    "menu.selectionBackground": "#504945",
    "menu.selectionBorder": "#00000000",
    "menu.separatorBackground": "#bbbbbb",
    "menu.border": "#00000085",

    // ---- 按钮 / 输入框 / 下拉 ----
    "button.background": "#504945",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#685a52",
    "button.secondaryForeground": "#ffffff",
    "button.secondaryBackground": "#504945",
    "button.secondaryHoverBackground": "#685a52",
    "input.background": "#181818",
    "input.foreground": "#bfbfbf",
    "input.border": "#00000000",
    "input.placeholderForeground": "#a6a6a6",
    "inputOption.activeBackground": "#504945",
    "inputOption.activeBorder": "#007acc00",
    "inputOption.activeForeground": "#e8e8e8",
    "dropdown.background": "#181818",
    "dropdown.foreground": "#bfbfbf",
    "dropdown.border": "#00000000",
    "checkbox.background": "#181818",
    "checkbox.foreground": "#bfbfbf",
    "checkbox.border": "#00000000",
    "textLink.foreground": "#95a2c9",
    "pickerGroup.foreground": "#8c8c8c",
    "pickerGroup.border": "#3f3f46",
    "progressBar.background": "#d8bd55",
    "badge.background": "#4d4d4d",
    "badge.foreground": "#ffffff",

    // ---- 编辑器：底色与正文 ----
    "editor.background": "#181818",
    "editor.foreground": "#c6c6c6",
    "editorLineNumber.foreground": "#9a9a9a",
    "editorLineNumber.activeForeground": "#d8bd55",
    "editorCursor.foreground": "#d8bd55",
    "editorCursor.background": "#000000",
    "editor.selectionBackground": "#504945",
    "editor.inactiveSelectionBackground": "#3a3d41",
    "editor.selectionHighlightBackground": "#add6ff26",
    "editor.selectionHighlightBorder": "#504945",
    "editor.wordHighlightBackground": "#575757b8",
    "editor.wordHighlightStrongBackground": "#004972b8",
    "editor.wordHighlightBorder": "#504945",
    "editor.hoverHighlightBackground": "#264f7840",
    "editor.lineHighlightBackground": "#e8e8e80a",
    "editor.lineHighlightBorder": "#282828",
    "editorWhitespace.foreground": "#e3e4e229",
    "editorIndentGuide.background1": "#404040",
    "editorIndentGuide.activeBackground1": "#707070",
    "editorRuler.foreground": "#5a5a5a",
    "editorBracketMatch.background": "#504945",
    "editorBracketMatch.border": "#504945",
    "editor.foldBackground": "#3d3734",
    "editorLink.activeForeground": "#95a2c9",
    "editorGutter.background": "#181818",
    "editorGutter.foldingControlForeground": "#c5c5c5",
    "editorCodeLens.foreground": "#999999",

    // ---- 查找 / 替换 ----
    "editor.findMatchBackground": "#504945",
    "editor.findMatchBorder": "#74879f",
    "editor.findMatchHighlightBackground": "#504945",
    "editor.findMatchHighlightBorder": "#e8e8e800",
    "editor.findRangeHighlightBackground": "#413b38",
    "editor.findRangeHighlightBorder": "#e8e8e800",
    "editor.rangeHighlightBackground": "#e8e8e80b",
    "editor.rangeHighlightBorder": "#e8e8e800",

    // ---- 诊断 ----
    "editorError.foreground": "#e35d64",
    "editorError.background": "#b73a3400",
    "editorError.border": "#e8e8e800",
    "editorWarning.foreground": "#d99f57",
    "editorWarning.background": "#a9904000",
    "editorWarning.border": "#e8e8e800",
    "editorInfo.foreground": "#7fb757",
    "editorInfo.background": "#4490bf00",
    "editorInfo.border": "#4490bf00",

    // ---- Git / 变更 ----
    "editorGutter.addedBackground": "#7fb757",
    "editorGutter.modifiedBackground": "#d99f57",
    "editorGutter.deletedBackground": "#c74e39",
    "minimapGutter.addedBackground": "#7fb757",
    "minimapGutter.modifiedBackground": "#d99f57",
    "minimapGutter.deletedBackground": "#c74e39",
    "editorOverviewRuler.addedForeground": "#7fb757",
    "editorOverviewRuler.modifiedForeground": "#d99f57",
    "editorOverviewRuler.deletedForeground": "#c74e39",
    "gitDecoration.addedResourceForeground": "#81b88b",
    "gitDecoration.modifiedResourceForeground": "#d6b98d",
    "gitDecoration.deletedResourceForeground": "#c74e39",
    "gitDecoration.untrackedResourceForeground": "#73c991",
    "gitDecoration.ignoredResourceForeground": "#8c8c8c",
    "gitDecoration.conflictingResourceForeground": "#6c6cc4",
    "gitDecoration.stageModifiedResourceForeground": "#d6b98d",
    "gitDecoration.stageDeletedResourceForeground": "#c74e39",
    "gitDecoration.submoduleResourceForeground": "#8db9e2",

    // ---- 缩略图 / 概览标尺 ----
    "editorOverviewRuler.background": "#25252500",
    "editorOverviewRuler.border": "#7f7f7f4d",
    "minimap.background": "#181818",
    "minimap.findMatchHighlight": "#504945",
    "minimap.selectionHighlight": "#504945",
    "minimap.errorHighlight": "#e35d64",
    "minimap.warningHighlight": "#d99f57",

    // ---- Diff ----
    "diffEditor.insertedTextBackground": "#9bb95533",
    "diffEditor.removedTextBackground": "#ff000033",
    "diffEditor.border": "#444444",

    // ---- 合并冲突 ----
    "merge.currentHeaderBackground": "#367366",
    "merge.currentContentBackground": "#27403b",
    "merge.incomingHeaderBackground": "#395f8f",
    "merge.incomingContentBackground": "#28384b",
    "merge.commonHeaderBackground": "#383838",
    "merge.commonContentBackground": "#282828",

    // ---- 标签页 / 编辑组 ----
    "editorGroup.border": "#444444",
    "editorGroup.emptyBackground": "#181818",
    "editorGroupHeader.tabsBackground": "#181818",
    "editorGroupHeader.tabsBorder": "#181818",
    "tab.activeBackground": "#181818",
    "tab.activeForeground": "#e8e8e8",
    "tab.activeBorder": "#d8bd55",
    "tab.activeBorderTop": "#00000000",
    "tab.inactiveBackground": "#1c1c1c",
    "tab.inactiveForeground": "#e8e8e880",
    "tab.border": "#252526",
    "tab.unfocusedActiveBorderTop": "#504945",

    // ---- 面包屑 ----
    "breadcrumb.background": "#181818",
    "breadcrumb.foreground": "#bfbfbfcc",
    "breadcrumb.focusForeground": "#e0e0e0",
    "breadcrumb.activeSelectionForeground": "#e0e0e0",

    // ---- 面板 / 终端 ----
    "panel.background": "#151515",
    "panel.border": "#80808059",
    "panelSection.border": "#80808059",
    "panelTitle.activeBorder": "#d8bd55",
    "panelTitle.activeForeground": "#d8bd55",
    "panelTitle.inactiveForeground": "#e7e7e799",
    "terminal.background": "#181818",
    "terminal.foreground": "#c6c6c6",
    "terminal.border": "#80808059",
    "terminal.selectionBackground": "#50494585",
    "terminalCursor.foreground": "#d8bd55",
    "terminalCursor.background": "#000000",
    "terminal.ansiBlack": "#484848",
    "terminal.ansiRed": "#d05f61",
    "terminal.ansiGreen": "#7dbf55",
    "terminal.ansiYellow": "#d8bd55",
    "terminal.ansiBlue": "#96a6c8",
    "terminal.ansiMagenta": "#9e95c7",
    "terminal.ansiCyan": "#95a99f",
    "terminal.ansiWhite": "#d6d7e2",
    "terminal.ansiBrightBlack": "#6b6b6b",
    "terminal.ansiBrightRed": "#e8707a",
    "terminal.ansiBrightGreen": "#93cd6c",
    "terminal.ansiBrightYellow": "#e5cf6e",
    "terminal.ansiBrightBlue": "#a8b6d2",
    "terminal.ansiBrightMagenta": "#b0a8d0",
    "terminal.ansiBrightCyan": "#a8bcb2",
    "terminal.ansiBrightWhite": "#dfe0ea",

    // ---- 通知 ----
    "notifications.foreground": "#bfbfbf",
    "notifications.background": "#181818",
    "notifications.border": "#504945",
    "notificationToast.border": "#504945",
    "notificationCenter.border": "#474747",
    "notificationCenterHeader.foreground": "#bfbfbf",
    "notificationCenterHeader.background": "#504945",
    "notificationsErrorIcon.foreground": "#e35d64",
    "notificationsWarningIcon.foreground": "#d99f57",
    "notificationsInfoIcon.foreground": "#95a2c9",

    // ---- 浮层 / 补全 / 悬停 ----
    "editorWidget.foreground": "#bfbfbf",
    "editorWidget.background": "#282828",
    "editorWidget.border": "#504945",
    "editorWidget.resizeBorder": "#504945",
    "editorSuggestWidget.background": "#282828",
    "editorSuggestWidget.border": "#504945",
    "editorSuggestWidget.foreground": "#c6c6c6",
    "editorSuggestWidget.highlightForeground": "#d8bd55",
    "editorSuggestWidget.selectedBackground": "#504945",
    "editorHoverWidget.foreground": "#bfbfbf",
    "editorHoverWidget.background": "#282828",
    "editorHoverWidget.border": "#504945",
    "editorMarkerNavigation.background": "#1d1b1a",
    "editorMarkerNavigationError.background": "#b87d71",
    "editorMarkerNavigationWarning.background": "#d99f57",
    "editorMarkerNavigationInfo.background": "#7fb757",

    // ---- Peek View ----
    "peekView.border": "#504945",
    "peekViewEditor.background": "#181818",
    "peekViewEditorGutter.background": "#181818",
    "peekViewEditor.matchHighlightBackground": "#ff8f0099",
    "peekViewEditor.matchHighlightBorder": "#ee931e",
    "peekViewResult.background": "#282828",
    "peekViewResult.fileForeground": "#e8e8e8",
    "peekViewResult.lineForeground": "#bbbbbb",
    "peekViewResult.matchHighlightBackground": "#ea5c004d",
    "peekViewResult.selectionBackground": "#504945",
    "peekViewResult.selectionForeground": "#e8e8e8",
    "peekViewTitle.background": "#1e1e1e",
    "peekViewTitleDescription.foreground": "#bfbfbfb3",
    "peekViewTitleLabel.foreground": "#e8e8e8",

    // ---- 滚动条 ----
    "scrollbar.shadow": "#00000000",
    "scrollbarSlider.background": "#111111",
    "scrollbarSlider.hoverBackground": "#646464b3",
    "scrollbarSlider.activeBackground": "#bfbfbf66",

    // ---- 调试 ----
    "debugToolBar.background": "#181818",
    "debugToolBar.border": "#181818",
    "debugExceptionWidget.background": "#181818",
    "debugExceptionWidget.border": "#181818",

    // ---- 设置页 ----
    "settings.headerForeground": "#e1dad5",
    "settings.focusedRowBackground": "#e8e8e807",
    "walkThrough.embeddedEditorBackground": "#00000050",

    // ---- 内嵌聊天 / Chat ----
    "inlineChat.background": "#282828",
    "inlineChat.foreground": "#c6c6c6",
    "inlineChat.border": "#504945",
    "inlineChatInput.background": "#181818",
    "inlineChatInput.border": "#504945",
    "inlineChatInput.focusBorder": "#d8bd55",
    "chat.requestBackground": "#1c1c1c",
    "chat.requestBorder": "#504945",
    "chat.slashCommandBackground": "#504945",
    "chat.slashCommandForeground": "#d8bd55",
    "chat.editedFileForeground": "#d6b98d"
  },

  // ============================================================
  // semanticTokenColors：让 TS / Go / Rust 等走语义高亮时
  // 与下面的 tokenColors 保持同一套配色
  // ============================================================
  "semanticTokenColors": {
    "comment": "#858585",
    "keyword": "#d8bd55",
    "modifier": "#d8bd55",
    "string": "#7fb757",
    "number": "#dc7a45",
    "regexp": "#7fb757",
    "operator": "#c6c6c6",
    "variable": "#c6c6c6",
    "variable.readonly": "#94b0a6",
    "variable.defaultLibrary": "#949bb0",
    "parameter": "#c6c6c6",
    "property": "#c6c6c6",
    "property.readonly": "#94b0a6",
    "function": "#949bb0",
    "method": "#949bb0",
    "class": "#949bb0",
    "interface": "#949bb0",
    "struct": "#949bb0",
    "enum": "#949bb0",
    "enumMember": "#c6c6c6",
    "type": "#94b0a6",
    "typeParameter": "#94b0a6",
    "namespace": "#94b0a6",
    "decorator": "#95a2c9",
    "selfKeyword": "#949bb0",
    "constant": "#94b0a6",
    "magicFunction": "#949bb0"
  },

  // ============================================================
  // tokenColors：Gruber Darker 语义
  //   关键字 #d8bd55 / 字符串 #7fb757 / 注释 #858585
  //   数字 #dc7a45 / 函数 #949bb0 / 类型·常量 #94b0a6
  // ============================================================
  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#858585" }
    },
    {
      "name": "Comment Documentation",
      "scope": ["comment.block.documentation", "comment.line.documentation"],
      "settings": { "foreground": "#858585" }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword", "keyword.control", "keyword.declaration",
        "storage", "storage.type", "storage.modifier"
      ],
      "settings": { "foreground": "#d8bd55" }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#c6c6c6" }
    },
    {
      "name": "Operator Assignment",
      "scope": ["keyword.operator.assignment"],
      "settings": { "foreground": "#d8bd55" }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function", "support.function", "variable.function",
        "meta.function-call.generic", "meta.require"
      ],
      "settings": { "foreground": "#949bb0" }
    },
    {
      "name": "Builtin",
      "scope": ["support.function.builtin", "support.function.console", "support.variable.magic"],
      "settings": { "foreground": "#d8bd55" }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type", "entity.name.class", "support.type", "support.class",
        "entity.other.inherited-class", "storage.type.primitive",
        "meta.return-type", "meta.type.annotation", "support.type.primitive"
      ],
      "settings": { "foreground": "#94b0a6" }
    },
    {
      "name": "Namespace / Module",
      "scope": [
        "entity.name.namespace", "entity.name.type.module", "entity.name.package",
        "support.module", "support.type.object.module"
      ],
      "settings": { "foreground": "#94b0a6" }
    },
    {
      "name": "Constant",
      "scope": [
        "constant", "constant.language", "constant.other", "support.constant",
        "variable.other.constant"
      ],
      "settings": { "foreground": "#94b0a6" }
    },
    {
      "name": "Language Variable",
      "scope": ["variable.language"],
      "settings": { "foreground": "#949bb0" }
    },
    {
      "name": "Number",
      "scope": ["constant.numeric"],
      "settings": { "foreground": "#dc7a45" }
    },
    {
      "name": "String",
      "scope": ["string", "punctuation.definition.string"],
      "settings": { "foreground": "#7fb757" }
    },
    {
      "name": "String Escape",
      "scope": ["constant.character.escape", "punctuation.definition.template-expression"],
      "settings": { "foreground": "#d8bd55" }
    },
    {
      "name": "Regexp",
      "scope": ["string.regexp", "constant.regexp", "constant.character.character-class.regexp"],
      "settings": { "foreground": "#c6c6c6" }
    },
    {
      "name": "Variable",
      "scope": ["variable", "variable.parameter", "variable.other", "meta.object-literal.key"],
      "settings": { "foreground": "#c6c6c6" }
    },
    {
      "name": "Variable Property",
      "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property"],
      "settings": { "foreground": "#c6c6c6" }
    },
    {
      "name": "Attribute / Property Name",
      "scope": ["entity.other.attribute-name", "support.type.property-name"],
      "settings": { "foreground": "#95a2c9" }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#d8bd55" }
    },
    {
      "name": "Preprocessor",
      "scope": [
        "meta.preprocessor", "keyword.control.import", "keyword.control.directive",
        "entity.name.function.preprocessor"
      ],
      "settings": { "foreground": "#94b0a6" }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation", "punctuation.separator", "punctuation.terminator",
        "punctuation.section", "meta.brace"
      ],
      "settings": { "foreground": "#c6c6c6" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal", "invalid.broken"],
      "settings": { "foreground": "#ffffff", "background": "#e35d64" }
    },
    {
      "name": "Deprecated",
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "#e8e8e8" }
    },

    // ---------- JSON ----------
    {
      "name": "JSON Property Key",
      "scope": ["support.type.property-name.json", "support.type.property-name.json punctuation"],
      "settings": { "foreground": "#c6c6c6" }
    },
    {
      "name": "JSON Value String",
      "scope": ["source.json meta.structure.dictionary.json > value.json > string.quoted.json"],
      "settings": { "foreground": "#7fb757" }
    },
    {
      "name": "JSON Constant",
      "scope": ["constant.language.json"],
      "settings": { "foreground": "#94b0a6" }
    },

    // ---------- YAML ----------
    {
      "name": "YAML Key",
      "scope": ["entity.name.tag.yaml"],
      "settings": { "foreground": "#c6c6c6" }
    },
    {
      "name": "YAML String",
      "scope": ["string.yaml"],
      "settings": { "foreground": "#7fb757" }
    },
    {
      "name": "YAML Anchor & Alias",
      "scope": ["variable.other.anchor.yaml", "variable.other.alias.yaml"],
      "settings": { "foreground": "#d8bd55" }
    },

    // ---------- Markdown ----------
    {
      "name": "Markdown Heading",
      "scope": ["markup.heading", "entity.name.section", "markup.heading.setext"],
      "settings": { "foreground": "#c6c6c6", "fontStyle": "bold" }
    },
    {
      "name": "Markdown Bold",
      "scope": ["markup.bold", "punctuation.definition.bold"],
      "settings": { "foreground": "#c6c6c6", "fontStyle": "bold" }
    },
    {
      "name": "Markdown Italic",
      "scope": ["markup.italic", "punctuation.definition.italic"],
      "settings": { "foreground": "#d8bd55", "fontStyle": "italic" }
    },
    {
      "name": "Markdown Link",
      "scope": ["markup.underline.link", "string.other.link.title", "string.other.link.description"],
      "settings": { "foreground": "#d8bd55" }
    },
    {
      "name": "Markdown Raw",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": { "foreground": "#7fb757" }
    },
    {
      "name": "Markdown Quote",
      "scope": ["markup.quote"],
      "settings": { "foreground": "#d99f57" }
    },
    {
      "name": "Markdown List",
      "scope": ["punctuation.definition.list", "beginning.punctuation.definition.list"],
      "settings": { "foreground": "#c6c6c6" }
    },

    // ---------- Diff ----------
    {
      "name": "Diff Inserted",
      "scope": ["markup.inserted", "markup.inserted.diff"],
      "settings": { "foreground": "#7fb757" }
    },
    {
      "name": "Diff Deleted",
      "scope": ["markup.deleted", "markup.deleted.diff"],
      "settings": { "foreground": "#e35d64" }
    },
    {
      "name": "Diff Changed",
      "scope": ["markup.changed", "markup.changed.diff"],
      "settings": { "foreground": "#949bb0" }
    },
    {
      "name": "Diff Header",
      "scope": ["meta.diff.header", "meta.diff.header.from-file", "meta.diff.header.to-file"],
      "settings": { "foreground": "#95a2c9" }
    }
  ]
}
