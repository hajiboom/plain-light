{
  "$schema": "vscode://schemas/color-theme",
  "name": "Vinci Dark (Warm)",
  "type": "dark",
  "colors": {
    // ========== 透明窗口适配：实心底色 + 高亮文字 ==========
    // 背景全部不透明，确保透明插件作用下仍有足够底色支撑文字
    // 所有前景色向白色靠拢，token 色高饱和高亮度
    "contrastBorder": "#484848",
    "focusBorder": "#88c8f0",
    "widget.shadow": "#00000060",

    // ---- 编辑器：不透底 + 近白文字 ----
    "editor.background": "#282c30",
    "editor.foreground": "#faf8f2",
    "editor.lineHighlightBackground": "#2d3136",
    "editor.selectionBackground": "#4a6890",
    "editor.selectionHighlightBackground": "#4a689060",
    "editorCursor.foreground": "#90e0ff",
    "editorWhitespace.foreground": "#3c4046",
    "editorIndentGuide.background1": "#34383e",
    "editorIndentGuide.activeBackground1": "#788088",
    "editorLineNumber.foreground": "#a8acb0",
    "editorLineNumber.activeForeground": "#f4f0e8",
    "editorRuler.foreground": "#34383e",
    "editorBracketMatch.background": "#406050",
    "editorBracketMatch.border": "#88c8f0",
    "editor.findMatchBackground": "#60585880",
    "editor.findMatchHighlightBackground": "#50484860",

    // ---- Git 变更 ----
    "editorGutter.addedBackground": "#58b85c",
    "editorGutter.modifiedBackground": "#4898e0",
    "editorGutter.deletedBackground": "#e84848",
    "minimapGutter.addedBackground": "#58b85c",
    "minimapGutter.modifiedBackground": "#4898e0",
    "minimapGutter.deletedBackground": "#e84848",
    "editorOverviewRuler.addedForeground": "#58b85c",
    "editorOverviewRuler.modifiedForeground": "#4898e0",
    "editorOverviewRuler.deletedForeground": "#e84848",
    "gitDecoration.addedResourceForeground": "#58b85c",
    "gitDecoration.modifiedResourceForeground": "#4898e0",
    "gitDecoration.deletedResourceForeground": "#e84848",
    "gitDecoration.untrackedResourceForeground": "#e0d060",
    "gitDecoration.ignoredResourceForeground": "#787c80",

    // ---- 侧边栏 ----
    "sideBar.background": "#24282c",
    "sideBar.foreground": "#f8f4f0",
    "sideBarSectionHeader.background": "#202428",
    "sideBarSectionHeader.foreground": "#f8f4f0",
    "sideBarTitle.foreground": "#f8f4f0",
    "sideBar.border": "#3c4044",

    // ---- 活动栏 ----
    "activityBar.background": "#202428",
    "activityBar.foreground": "#f4f0e8",
    "activityBar.inactiveForeground": "#a0a4a8",
    "activityBar.border": "#3c4044",
    "activityBar.activeBorder": "#90e0ff",
    "activityBar.activeBackground": "#24282c",

    // ---- 底部状态栏 ----
    "statusBar.background": "#202428",
    "statusBar.foreground": "#f4f0e8",
    "statusBar.border": "#3c4044",
    "statusBar.noFolderBackground": "#202428",
    "statusBar.debuggingBackground": "#b86820",

    // ---- 命令中心 ----
    "commandCenter.foreground": "#f4f0e8",
    "commandCenter.activeForeground": "#90e0ff",
    "commandCenter.inactiveForeground": "#a0a4a8",
    "commandCenter.background": "#24282c",
    "commandCenter.activeBackground": "#2d3136",
    "commandCenter.border": "#3c4044",
    "commandCenter.inactiveBorder": "#3c4044",
    "commandCenter.debuggingBackground": "#b86820",

    // ---- 标题栏 ----
    "titleBar.activeBackground": "#007894",
    "titleBar.activeForeground": "#ffffff",
    "titleBar.inactiveBackground": "#202428",
    "titleBar.inactiveForeground": "#a8a8a4",
    "titleBar.border": "#3c4044",

    // ---- 菜单 ----
    "menu.background": "#303438",
    "menu.foreground": "#f4f0e8",
    "menu.selectionBackground": "#4a6890",
    "menu.selectionForeground": "#ffffff",
    "menu.border": "#484848",

    // ---- 面板 / 终端：亚光暗调，与编辑器一致 ----
    "panel.background": "#24282c",
    "panel.border": "#3c4044",
    "panelTitle.activeForeground": "#e8e4de",
    "panelTitle.inactiveForeground": "#989c9e",

    "terminal.background": "#24282c",
    "terminal.foreground": "#f4f0e8",
    "terminal.selectionBackground": "#4a689080",
    "terminalCursor.foreground": "#88c8f0",
    "terminal.ansiBlack": "#1c1c1c",
    "terminal.ansiRed": "#e87878",
    "terminal.ansiGreen": "#88c878",
    "terminal.ansiYellow": "#d8c878",
    "terminal.ansiBlue": "#80a8e0",
    "terminal.ansiMagenta": "#c888d0",
    "terminal.ansiCyan": "#78c8d8",
    "terminal.ansiWhite": "#d8d8d8",
    "terminal.ansiBrightBlack": "#686868",
    "terminal.ansiBrightRed": "#f89898",
    "terminal.ansiBrightGreen": "#a8e898",
    "terminal.ansiBrightYellow": "#f0e090",
    "terminal.ansiBrightBlue": "#a0c0f8",
    "terminal.ansiBrightMagenta": "#e0a0e8",
    "terminal.ansiBrightCyan": "#98e0f0",
    "terminal.ansiBrightWhite": "#f8f8f8",

    // ---- 列表/树 ----
    "list.activeSelectionBackground": "#4a6890",
    "list.activeSelectionForeground": "#ffffff",
    "list.inactiveSelectionBackground": "#305060",
    "list.inactiveSelectionForeground": "#f8f4f0",
    "list.hoverBackground": "#34383e",
    "list.hoverForeground": "#fcfaf8",
    "list.focusBackground": "#4a6890",
    "list.focusForeground": "#ffffff",
    "list.highlightForeground": "#90f0ff",

    // ---- 输入框 / 下拉 / 按钮 ----
    "input.background": "#303438",
    "input.foreground": "#faf8f2",
    "input.border": "#484848",
    "input.placeholderForeground": "#a8acb0",
    "inputOption.activeBorder": "#90e0ff",
    "dropdown.background": "#303438",
    "dropdown.foreground": "#faf8f2",
    "dropdown.border": "#484848",

    "button.background": "#484c50",
    "button.foreground": "#faf8f2",
    "button.hoverBackground": "#585c60",
    "button.border": "#585858",

    "scrollbarSlider.background": "#484c50",
    "scrollbarSlider.hoverBackground": "#585c60",
    "scrollbarSlider.activeBackground": "#686c70",

    // ---- 标签栏 ----
    "editorGroup.border": "#3c4044",
    "editorGroupHeader.tabsBackground": "#202428",
    "editorGroupHeader.border": "#3c4044",
    "tab.activeBackground": "#282c30",
    "tab.inactiveBackground": "#202428",
    "tab.activeForeground": "#fcfaf8",
    "tab.inactiveForeground": "#d0ccc8",
    "tab.border": "#3c4044",
    "tab.activeBorder": "#007894",
    "tab.activeBorderTop": "#007894",
    "tab.unfocusedActiveBorderTop": "#484848",

    // ---- 通知 ----
    "notifications.background": "#303438",
    "notifications.foreground": "#faf8f2",
    "notificationsWarningIcon.foreground": "#f0e080",
    "notificationsErrorIcon.foreground": "#ff8080",
    "notificationsInfoIcon.foreground": "#90e0ff",

    // ---- 徽章 / 进度条 ----
    "badge.background": "#90e0ff",
    "badge.foreground": "#000000",
    "progressBar.background": "#90e0ff",

    // ---- 浮层 / 建议框 ----
    "editorWidget.background": "#303438",
    "editorWidget.border": "#484848",
    "editorSuggestWidget.background": "#303438",
    "editorSuggestWidget.border": "#484848",
    "editorSuggestWidget.selectedBackground": "#404448",
    "editorSuggestWidget.foreground": "#faf8f2",
    "editorHoverWidget.background": "#303438",
    "editorHoverWidget.border": "#484848",

    // ---- 内嵌聊天 / Chat ----
    "inlineChat.background": "#282c30",
    "inlineChat.foreground": "#faf8f2",
    "inlineChat.border": "#484848",
    "inlineChatInput.background": "#303438",
    "inlineChatInput.border": "#484848",
    "inlineChatInput.focusBorder": "#90e0ff",
    "chat.requestBackground": "#282c30",
    "chat.requestBorder": "#484848",
    "chat.slashCommandBackground": "#4a6890",
    "chat.slashCommandForeground": "#90e0ff",
    "chat.editedFileForeground": "#f0e080"
  },

  // ============================================================
  // tokenColors：霓虹增强，透明窗下文字自发光
  // ============================================================
  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#e0c890" }
    },

    {
      "name": "Keyword",
      "scope": [
        "keyword", "storage.type", "storage.modifier",
        "keyword.control", "keyword.declaration"
      ],
      "settings": { "foreground": "#fce888" }
    },

    {
      "name": "Function",
      "scope": [
        "entity.name.function", "support.function", "variable.function"
      ],
      "settings": { "foreground": "#c8d8ff" }
    },

    {
      "name": "Type",
      "scope": [
        "entity.name.type", "support.type", "storage.type.primitive"
      ],
      "settings": { "foreground": "#c0e8c0" }
    },

    {
      "name": "String",
      "scope": "string",
      "settings": { "foreground": "#a8e878" }
    },

    {
      "name": "Constant",
      "scope": [
        "constant.numeric", "constant.language", "constant.boolean"
      ],
      "settings": { "foreground": "#f8c888" }
    },

    {
      "name": "Variable",
      "scope": [
        "variable", "variable.parameter", "variable.other.member"
      ],
      "settings": { "foreground": "#faf8f2" }
    },

    {
      "name": "Variable Property",
      "scope": [
        "variable.other.property", "variable.object.property"
      ],
      "settings": { "foreground": "#d0e8ff" }
    },

    {
      "name": "Built-in",
      "scope": [
        "support.function.builtin", "support.constant"
      ],
      "settings": { "foreground": "#90f0ff" }
    },

    {
      "name": "Preprocessor",
      "scope": [
        "meta.preprocessor", "keyword.control.import"
      ],
      "settings": { "foreground": "#c0e8c0" }
    },

    {
      "name": "Warning",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#ff8888" }
    },

    {
      "name": "Operator",
      "scope": "keyword.operator",
      "settings": { "foreground": "#f4f0e8" }
    },

    {
      "name": "Punctuation",
      "scope": [
        "punctuation", "punctuation.separator", "punctuation.definition"
      ],
      "settings": { "foreground": "#e4e0d8" }
    },

    {
      "name": "Entity Tag",
      "scope": [
        "entity.name.tag", "entity.name.tag.html",
        "entity.name.tag.jsx", "entity.name.tag.tsx"
      ],
      "settings": { "foreground": "#98e8ff" }
    },

    {
      "name": "Entity Attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#d0e8ff" }
    },

    // ---------- JSON ----------
    {
      "name": "JSON Property Key",
      "scope": "support.type.property-name.json",
      "settings": { "foreground": "#90f0ff" }
    },
    {
      "name": "JSON Constant",
      "scope": "constant.language.json",
      "settings": { "foreground": "#fce888" }
    },

    // ---------- YAML ----------
    {
      "name": "YAML Key",
      "scope": "entity.name.tag.yaml",
      "settings": { "foreground": "#90f0ff" }
    },
    {
      "name": "YAML Constant",
      "scope": ["constant.language.yaml", "constant.numeric.yaml", "constant.other.timestamp.yaml"],
      "settings": { "foreground": "#f8c888" }
    },
    {
      "name": "YAML String",
      "scope": "string.yaml",
      "settings": { "foreground": "#a8e878" }
    },
    {
      "name": "YAML Anchor & Alias",
      "scope": ["variable.other.anchor.yaml", "variable.other.alias.yaml"],
      "settings": { "foreground": "#fce888" }
    },
    {
      "name": "YAML Punctuation",
      "scope": ["punctuation.definition.mapping.yaml", "punctuation.definition.sequence.yaml", "punctuation.definition.string.yaml"],
      "settings": { "foreground": "#e4e0d8" }
    },

    // ---------- SQL ----------
    {
      "name": "SQL Keyword",
      "scope": ["keyword.sql", "keyword.ddl.sql", "keyword.dml.sql"],
      "settings": { "foreground": "#fce888" }
    },
    {
      "name": "SQL Built-in Function",
      "scope": "support.function.sql",
      "settings": { "foreground": "#90f0ff" }
    },
    {
      "name": "SQL Table Name",
      "scope": "entity.name.table.sql",
      "settings": { "foreground": "#c0e8c0" }
    },
    {
      "name": "SQL Column Name",
      "scope": "entity.name.column.sql",
      "settings": { "foreground": "#faf8f2" }
    },

    // ---------- Markdown ----------
    {
      "name": "Markdown Heading",
      "scope": ["markup.heading", "entity.name.section.markdown"],
      "settings": { "foreground": "#fce888", "fontStyle": "bold" }
    },
    {
      "name": "Markdown Bold",
      "scope": "markup.bold",
      "settings": { "foreground": "#c8d8ff", "fontStyle": "bold" }
    },
    {
      "name": "Markdown Italic",
      "scope": "markup.italic",
      "settings": { "foreground": "#e0c890", "fontStyle": "italic" }
    },
    {
      "name": "Markdown Link URL",
      "scope": "markup.link.url",
      "settings": { "foreground": "#a8e878", "fontStyle": "underline" }
    },
    {
      "name": "Markdown Link Text",
      "scope": "string.other.link.title.markdown",
      "settings": { "foreground": "#90f0ff" }
    },
    {
      "name": "Markdown Quote",
      "scope": "markup.quote",
      "settings": { "foreground": "#e0c890" }
    },
    {
      "name": "Markdown Code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": { "foreground": "#a8e878" }
    },
    {
      "name": "Markdown List Bullet",
      "scope": "punctuation.definition.list.markdown",
      "settings": { "foreground": "#90f0ff" }
    }
  ]
}
