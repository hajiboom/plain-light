{
  "$schema": "vscode://schemas/color-theme",
  "name": "Tsoding Emacs Dark (Gruber Darcula)",
  "type": "dark",
  "colors": {
    // ---- 编辑器整体UI全部采用One Half Dark色系，只更换全部界面背景层级，语法高亮完全不动 ----
    "editor.background": "#1e222a",
    "editor.foreground": "#dcdfe4",
    "editor.lineHighlightBackground": "#282c34",
    "editor.selectionBackground": "#3e4451",
    "editor.selectionHighlightBackground": "#343a46",
    "editorCursor.foreground": "#82A8D9",
    "editorWhitespace.foreground": "#3a3f4b",
    "editorIndentGuide.background": "#282c34",
    "editorIndentGuide.activeBackground": "#4b5263",
    "editorLineNumber.foreground": "#5c6374",
    "editorLineNumber.activeForeground": "#dcdfe4",
    "editorRuler.foreground": "#282c34",
    "editorBracketMatch.background": "#282c34",
    "editorBracketMatch.border": "#82A8D9",

    // ---- 侧边栏 One Half Dark 层级 ----
    "sideBar.background": "#272c35",
    "sideBar.foreground": "#dcdfe4",
    "sideBarSectionHeader.background": "#22262e",
    "sideBarSectionHeader.foreground": "#dcdfe4",
    "sideBarTitle.foreground": "#dcdfe4",
    "sideBar.border": "#1e222a",

    // ---- 活动栏 ----
    "activityBar.background": "#181b21",
    "activityBar.foreground": "#dcdfe4",
    "activityBar.inactiveForeground": "#5c6374",
    "activityBar.border": "#1e222a",
    "activityBar.activeBorder": "#82A8D9",
    "activityBar.activeBackground": "#272c35",

    // ---- 底部状态栏 ----
    "statusBar.background": "#181b21",
    "statusBar.foreground": "#dcdfe4",
    "statusBar.border": "#1e222a",
    "statusBar.noFolderBackground": "#181b21",
    "statusBar.debuggingBackground": "#181b21",

    // ---- 顶部标题栏 Go 蓝色完全沿用旧版配置，无改动 ----
    "titleBar.activeBackground": "#007894",
    "titleBar.activeForeground": "#ffffff",
    "titleBar.inactiveBackground": "#005c72",
    "titleBar.inactiveForeground": "#d0d0d0",
    "titleBar.border": "#006982",

    // ---- 顶部菜单栏 沿用旧版 ----
    "menu.background": "#006982",
    "menu.foreground": "#ffffff",
    "menu.selectionBackground": "#007894",
    "menu.selectionForeground": "#ffffff",
    "menu.border": "#005c72",

    // ---- 面板 / 终端 背景同步One Half Dark底色 ----
    "panel.background": "#272c35",
    "panel.border": "#1e222a",
    "panelTitle.activeForeground": "#dcdfe4",
    "panelTitle.inactiveForeground": "#5c6374",

    "terminal.background": "#1e222a",
    "terminal.foreground": "#dcdfe4",
    "terminal.selectionBackground": "#3e4451",
    "terminalCursor.foreground": "#82A8D9",
    "terminal.ansiBlack": "#1a1a1a",
    "terminal.ansiRed": "#b02b3d",
    "terminal.ansiGreen": "#5ea832",
    "terminal.ansiYellow": "#e6c72e",
    "terminal.ansiBlue": "#82A8D9",
    "terminal.ansiMagenta": "#a066b8",
    "terminal.ansiCyan": "#60b8d8",
    "terminal.ansiWhite": "#d8d8d8",
    "terminal.ansiBrightBlack": "#666666",
    "terminal.ansiBrightRed": "#d13a4f",
    "terminal.ansiBrightGreen": "#73c936",
    "terminal.ansiBrightYellow": "#ffdd33",
    "terminal.ansiBrightBlue": "#96a6c8",
    "terminal.ansiBrightMagenta": "#b87ad0",
    "terminal.ansiBrightCyan": "#7fd0e8",
    "terminal.ansiBrightWhite": "#f0f0f0",

    // ---- 列表选中样式保留你最终定稿的高对比青蓝选中样式，不换色 ----
    "list.activeSelectionBackground": "#3a454d",
    "list.activeSelectionForeground": "#ffffff",
    "list.inactiveSelectionBackground": "#333c42",
    "list.inactiveSelectionForeground": "#e4e4e4",
    "list.hoverBackground": "#323232",
    "list.hoverForeground": "#e4e4e4",
    "list.focusBackground": "#3a454d",
    "list.focusForeground": "#ffffff",
    "list.highlightForeground": "#52b7d2",

    // ---- 输入框、按钮、滚动条等UI背景适配One Half Dark，交互色保留旧逻辑 ----
    "input.background": "#2c313a",
    "input.foreground": "#dcdfe4",
    "input.border": "#1e222a",
    "input.placeholderForeground": "#5c6374",
    "dropdown.background": "#2c313a",
    "dropdown.foreground": "#dcdfe4",
    "dropdown.border": "#1e222a",

    "button.background": "#333333",
    "button.foreground": "#e4e4e4",
    "button.hoverBackground": "#36454b",

    "scrollbarSlider.background": "#333333",
    "scrollbarSlider.hoverBackground": "#404040",
    "scrollbarSlider.activeBackground": "#4a4a4a",

    "editorGroup.border": "#1e222a",
    "editorGroupHeader.tabsBackground": "#272c35",
    "tab.activeBackground": "#1e222a",
    "tab.inactiveBackground": "#272c35",
    "tab.activeForeground": "#dcdfe4",
    "tab.inactiveForeground": "#5c6374",
    "tab.border": "#1e222a",
    "tab.activeBorder": "#007894",

    "notification.background": "#2c313a",
    "notification.foreground": "#dcdfe4",
    "notificationCenter.border": "#1e222a",
    "notificationToast.border": "#1e222a",

    "badge.background": "#82A8D9",
    "badge.foreground": "#ffffff",
    "progressBar.background": "#82A8D9",
    "editorWidget.background": "#2c313a",
    "editorWidget.border": "#1e222a"
  },

  // 【重点完全原样照搬】tokenColors 语法高亮一分一毫未改动，沿用你长期使用的全套配色
  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#b07a35"
      }
    },

    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.declaration"
      ],
      "settings": {
        "foreground": "#e6c72e"
      }
    },

    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#8a9abc"
      }
    },

    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "support.type",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#889a90"
      }
    },

    {
      "name": "String",
      "scope": "string",
      "settings": {
        "foreground": "#5ea832"
      }
    },

    {
      "name": "Constant",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.boolean"
      ],
      "settings": {
        "foreground": "#889a90"
      }
    },

    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other.member"
      ],
      "settings": {
        "foreground": "#d3d3d5"
      }
    },

    {
      "name": "Built-in",
      "scope": [
        "support.function.builtin",
        "support.constant"
      ],
      "settings": {
        "foreground": "#52b7d2"
      }
    },

    {
      "name": "Preprocessor",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#889a90"
      }
    },

    {
      "name": "Warning",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#f43841"
      }
    },

    {
      "name": "Operator",
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#d8d8d8"
      }
    },

    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.definition"
      ],
      "settings": {
        "foreground": "#cfcece"
      }
    },

    // ---------- JSON 文件专属高亮 ----------
    {
      "name": "JSON Property Key",
      "scope": "support.type.property-name.json",
      "settings": {
        "foreground": "#52b7d2"
      }
    },
    {
      "name": "JSON Constant (true/false/null)",
      "scope": "constant.language.json",
      "settings": {
        "foreground": "#e6c72e"
      }
    },

    // ---------- YAML 文件专属高亮 ----------
    {
      "name": "YAML Key",
      "scope": "entity.name.tag.yaml",
      "settings": {
        "foreground": "#52b7d2"
      }
    },
    {
      "name": "YAML Constant",
      "scope": [
        "constant.language.yaml",
        "constant.numeric.yaml",
        "constant.other.timestamp.yaml"
      ],
      "settings": {
        "foreground": "#889a90"
      }
    },
    {
      "name": "YAML String",
      "scope": "string.yaml",
      "settings": {
        "foreground": "#5ea832"
      }
    },
    {
      "name": "YAML Anchor & Alias",
      "scope": [
        "variable.other.anchor.yaml",
        "variable.other.alias.yaml"
      ],
      "settings": {
        "foreground": "#e6c72e"
      }
    },
    {
      "name": "YAML Punctuation",
      "scope": [
        "punctuation.definition.mapping.yaml",
        "punctuation.definition.sequence.yaml",
        "punctuation.definition.string.yaml"
      ],
      "settings": {
        "foreground": "#cfcece"
      }
    },

    // ---------- SQL 文件专属高亮 ----------
    {
      "name": "SQL Keyword",
      "scope": [
        "keyword.sql",
        "keyword.ddl.sql",
        "keyword.dml.sql"
      ],
      "settings": {
        "foreground": "#e6c72e"
      }
    },
    {
      "name": "SQL Built-in Function",
      "scope": "support.function.sql",
      "settings": {
        "foreground": "#52b7d2"
      }
    },
    {
      "name": "SQL Table Name",
      "scope": "entity.name.table.sql",
      "settings": {
        "foreground": "#889a90"
      }
    },
    {
      "name": "SQL Column Name",
      "scope": "entity.name.column.sql",
      "settings": {
        "foreground": "#d3d3d5"
      }
    },

    // ---------- Markdown 文件专属高亮 ----------
    {
      "name": "Markdown Heading",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#e6c72e",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Bold",
      "scope": "markup.bold",
      "settings": {
        "foreground": "#8a9abc",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Italic",
      "scope": "markup.italic",
      "settings": {
        "foreground": "#b07a35",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Link URL",
      "scope": "markup.link.url",
      "settings": {
        "foreground": "#5ea832",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown Link Text",
      "scope": "string.other.link.title.markdown",
      "settings": {
        "foreground": "#52b7d2"
      }
    },
    {
      "name": "Markdown Quote",
      "scope": "markup.quote",
      "settings": {
        "foreground": "#b07a35"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#5ea832"
      }
    },
    {
      "name": "Markdown List Bullet",
      "scope": "punctuation.definition.list.markdown",
      "settings": {
        "foreground": "#52b7d2"
      }
    }
  ]
}