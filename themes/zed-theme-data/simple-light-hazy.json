{
  "$schema": "https://zed.dev/schema/themes/v0.2.0",
  "author": "neoh",
  "name": "Simple Light",
  "themes": [
    {
      "name": "Simple Light Hazy",
      "appearance": "light",
      "style": {
        // ============================================================
        // 毛玻璃层级：与 Simple Dark Hazy 相同的 alpha 结构
        //   editor / panel 完全透明 (00)，表面 70% (B3)，
        //   标题栏 74% (BC)，浮层 90% (E6)
        // 底色为暖白 #F5F5F5 + go.dev 藏蓝 UI（暖色低对比，减轻散光光晕）
        // ============================================================
        "background.appearance": "blurred",
        "background": "#f5f5f5E6",
        "editor.background": "#f5f5f500",
        "editor.gutter.background": "#f5f5f500",
        "editor.subheader.background": "#ecececBC",
        "editor.line_number": "#9e9e9e",
        "editor.active_line_number": "#1a1a1a",
        "editor.foreground": "#1a1a1a",
        "editor.element.background": "#ffffff22",
        "editor.invisible": "#dcdcdc",
        "editor.indent_guide": "#e6e6e6",
        "editor.indent_guide_active": "#b0b0b0",
        "editor.wrap_guide": "#e6e6e6",
        "editor.active_wrap_guide": "#b0b0b0",
        "editor.highlighted_line.background": "#edededDD",
        "editor.selection.background": "#cce4ffE6",
        "editor.selection.foreground": "#1a1a1a",
        "editor.document_highlight.read_background": "#cce4ff33",
        "editor.document_highlight.write_background": "#cce4ff40",
        "editor.document_highlight.bracket_background": "#00789426",
        "editor.search.match_background": "#FDE3A780",
        "editor.active_search_match_background": "#FDE3A7B3",
        "editor.hunk.background": "#1a7f3726",
        "editor.hunk_line": "#1a7f37",
        "editor.deleted_line_background": "#b31d2826",
        "scrollbar.track.background": "#ececec2D",
        "scrollbar.track.border": "#dcdcdc",
        "scrollbar.thumb.background": "#c0c0c0B3",
        "scrollbar.thumb.hover_background": "#9e9e9eB3",
        "scrollbar.thumb.active_background": "#00789480",
        "minimap.thumb.background": "#c0c0c059",
        "minimap.thumb.hover_background": "#9e9e9e73",
        "minimap.thumb.active_background": "#007894A6",

        // ---- 窗口 / 标题栏：仅顶部保留 go.dev 藏蓝 ----
        "title_bar.background": "#007894BC",
        "title_bar.inactive_background": "#005c726B",
        "toolbar.background": "#fafafa1A",
        "panel.background": "#f5f5f500",
        "panel.overlay_background": "#fafafaF2",
        "panel.indent_guide": "#e6e6e6A6",
        "panel.indent_guide_active": "#b0b0b0",
        "status_bar.background": "#ecececBC",
        "status_bar.border": "#dcdcdcA6",
        "tab_bar.background": "#ececec11",
        "tab.active_background": "#f5f5f555",
        "tab.inactive_background": "#ececec22",
        "tab.active_foreground": "#1a1a1a",
        "tab.inactive_foreground": "#6e6e6e",
        "tab_bar.active_border": "#007894",
        "tab_bar.inactive_border": "#dcdcdc",

        "surface.background": "#ecececBC",
        "element.background": "#fafafa22",
        "element.hover": "#e6e6e6AA",
        "element.active": "#dcdcdcD9",
        "element.selected": "#cce4ffCC",
        "element.disabled": "#fafafa3F",
        "ghost_element.background": "#fafafa11",
        "ghost_element.hover": "#e6e6e65A",
        "ghost_element.active": "#dcdcdc99",
        "ghost_element.selected": "#cce4ffB3",
        "elevated_surface.background": "#fafafaE6",
        "notification.background": "#fafafaE6",
        "notification.border": "#d4d4d4",

        // ---- 边框 ----
        "border": "#d4d4d48C",
        "border.variant": "#dcdcdc",
        "border.focused": "#007894",
        "border.selected": "#00789498",
        "border.transparent": "#ffffff00",
        "border.disabled": "#d4d4d4",
        "pane.focused_border": "#007894",
        "pane_group.border": "#dcdcdcB8",
        "pane.unfocused_border": "#dcdcdc",
        "panel.focused_border": "#007894",
        "panel.indent_guide_hover": "#007894",

        // ---- 文本 ----
        "text": "#1a1a1a",
        "text.accent": "#007894",
        "text.muted": "#6e6e6e",
        "text.disabled": "#9e9e9e",
        "text.placeholder": "#8c8c8c",

        // ---- 列表 选中/悬停 ----
        "list.active_hover_background": "#ebebeb",
        "list.focus_foreground": "#1a1a1a",
        "list.highlight_foreground": "#007894",
        "list.hover_foreground": "#1a1a1a",

        // ---- Git ----
        "version_control.added": "#1a7f37",
        "version_control.modified": "#1b4b8f",
        "version_control.deleted": "#b31d28",
        "version_control.ignored": "#9e9e9e",
        "version_control.renamed": "#1b4b8f",

        // ---- 状态色 ----
        "error": "#b31d28",
        "error.background": "#b31d2826",
        "error.border": "#a87377",
        "warning": "#976404",
        "warning.background": "#97640426",
        "warning.border": "#8a4a04",
        "success": "#1a7f37",
        "success.background": "#1a7f3726",
        "success.border": "#276429",
        "info": "#1b4b8f",
        "info.background": "#1b4b8f26",
        "info.border": "#124f91",
        "link_text.hover": "#007894",

        // ---- 终端：simple-light 调色板 ----
        "terminal.background": "#f5f5f522",
        "terminal.foreground": "#1a1a1a",
        "terminal.bright_foreground": "#1a1a1a",
        "terminal.dim_foreground": "#6e6e6e",
        "terminal.ansi.background": "#f5f5f522",
        "terminal.ansi.black": "#1a1a1a",
        "terminal.ansi.dim_black": "#3a3a3a",
        "terminal.ansi.bright_black": "#4d4d4d",
        "terminal.ansi.red": "#b31d28",
        "terminal.ansi.dim_red": "#8a1620",
        "terminal.ansi.bright_red": "#d1242f",
        "terminal.ansi.green": "#1a7f37",
        "terminal.ansi.dim_green": "#136129",
        "terminal.ansi.bright_green": "#22863a",
        "terminal.ansi.yellow": "#8a6100",
        "terminal.ansi.dim_yellow": "#6b4b00",
        "terminal.ansi.bright_yellow": "#976404",
        "terminal.ansi.blue": "#1b4f8f",
        "terminal.ansi.dim_blue": "#143a6b",
        "terminal.ansi.bright_blue": "#2c63a8",
        "terminal.ansi.magenta": "#7a1fa2",
        "terminal.ansi.dim_magenta": "#5c1880",
        "terminal.ansi.bright_magenta": "#9a3fb8",
        "terminal.ansi.cyan": "#0e6e7a",
        "terminal.ansi.dim_cyan": "#0a545c",
        "terminal.ansi.bright_cyan": "#1a8a99",
        "terminal.ansi.white": "#6e6e6e",
        "terminal.ansi.dim_white": "#9e9e9e",
        "terminal.ansi.bright_white": "#1a1a1a",

        // ---- Git 状态细分 ----
        "renamed": "#1b4b8f",
        "renamed.background": "#1b4b8f26",
        "renamed.border": "#1b4b8f40",
        "created": "#1a7f37",
        "created.background": "#1a7f3726",
        "created.border": "#276429",
        "deleted": "#b31d28",
        "deleted.background": "#b31d2826",
        "deleted.border": "#a20f0e",
        "modified": "#976404",
        "modified.background": "#97640426",
        "modified.border": "#8a4a04",
        "conflict": "#f1a5ab",
        "conflict.background": "#b31d2826",
        "conflict.border": "#a87377",
        "hidden": "#9e9e9e",
        "hidden.background": "#ffffff3F",
        "ignored": "#9e9e9e",
        "ignored.background": "#ffffff33",
        "hint": "#9e9e9e",
        "hint.background": "#ececec62",
        "predictive": "#9e9e9e",
        "predictive.background": "#fafafa5A",
        "unreachable": "#b31d28",
        "unreachable.background": "#b31d2826",

        // ---- AI / 协作玩家色 ----
        "players": [
          { "background": "#007894", "cursor": "#007894", "selection": "#0078944D" },
          { "background": "#976404", "cursor": "#976404", "selection": "#9764044D" },
          { "background": "#1a7f37", "cursor": "#1a7f37", "selection": "#1a7f374D" },
          { "background": "#7a1fa2", "cursor": "#7a1fa2", "selection": "#7a1fa24D" },
          { "background": "#b31d28", "cursor": "#b31d28", "selection": "#b31d284D" },
          { "background": "#0e6e7a", "cursor": "#0e6e7a", "selection": "#0e6e7a4D" },
          { "background": "#1b4f8f", "cursor": "#1b4f8f", "selection": "#1b4f8f4D" },
          { "background": "#a4560a", "cursor": "#a4560a", "selection": "#a4560a4D" }
        ],
        "debugger.accent": "#976404",
        "editor.debugger_active_line.background": "#97640426",

        // ============================================================
        // 语法高亮：Linux vim 默认配色的暖白特调版
        //   语义映射同 vim —— 注释蓝 / 关键字橄榄 / 字符串红 /
        //   类型绿 / 函数青 / 预处理洋红（此处换成铁锈红，不引入紫色）；
        //   所有颜色按暖白底重新定亮度与饱和度，全部 ≥4.5:1。
        //   数字 / 常量 / 变量 / 运算符保持正文深灰，不着色。
        // ============================================================
        "syntax": {
          "comment": { "color": "#4b6577", "font_style": "italic" },
          "comment.doc": { "color": "#4b6577", "font_style": "italic" },
          "comment.documentation": { "color": "#4b6577", "font_style": "italic" },
          "comment.todo": { "color": "#976404", "font_style": "italic" },
          "comment.error": { "color": "#b31d28", "font_style": "italic" },
          "keyword": { "color": "#7a5c00" },
          "keyword.modifier": { "color": "#7a5c00" },
          "keyword.directive": { "color": "#8c3a1e" },
          "keyword.directive.define": { "color": "#8c3a1e" },
          "string": { "color": "#a3212b" },
          "string.escape": { "color": "#8c3a1e" },
          "string.regex": { "color": "#8c3a1e" },
          "string.special": { "color": "#0b6a78" },
          "string.special.path": { "color": "#0b6a78" },
          "string.special.url": { "color": "#0b6a78", "font_style": "italic" },
          "character": { "color": "#a3212b" },
          "character.special": { "color": "#8c3a1e" },
          "number": { "color": "#1a1a1a" },
          "number.float": { "color": "#1a1a1a" },
          "boolean": { "color": "#1a1a1a" },
          "constant": { "color": "#1a1a1a" },
          "constant.builtin": { "color": "#1a1a1a" },
          "constant.macro": { "color": "#1a1a1a" },
          "constructor": { "color": "#0b6a78" },
          "function": { "color": "#0b6a78" },
          "function.call": { "color": "#0b6a78" },
          "function.macro": { "color": "#0b6a78" },
          "function.builtin": { "color": "#0b6a78" },
          "function.method": { "color": "#0b6a78" },
          "function.method.call": { "color": "#0b6a78" },
          "function.decorator": { "color": "#0b6a78" },
          "type": { "color": "#1a7f37" },
          "type.builtin": { "color": "#1a7f37", "font_style": "italic" },
          "type.class.definition": { "color": "#1a7f37" },
          "type.definition": { "color": "#1a7f37" },
          "type.interface": { "color": "#1a7f37", "font_style": "italic" },
          "type.super": { "color": "#1a7f37", "font_style": "italic" },
          "variable": { "color": "#1a1a1a" },
          "variable.builtin": { "color": "#1a1a1a", "font_style": "italic" },
          "variable.member": { "color": "#1a1a1a" },
          "variable.parameter": { "color": "#1a1a1a" },
          "variable.special": { "color": "#1a1a1a", "font_style": "italic" },
          "property": { "color": "#1a1a1a" },
          "attribute": { "color": "#0b6a78", "font_style": "italic" },
          "operator": { "color": "#1a1a1a" },
          "punctuation": { "color": "#1a1a1a" },
          "punctuation.bracket": { "color": "#1a1a1a" },
          "punctuation.delimiter": { "color": "#1a1a1a" },
          "punctuation.list_marker": { "color": "#7a5c00" },
          "punctuation.special": { "color": "#1a1a1a" },
          "tag": { "color": "#7a5c00" },
          "tag.delimiter": { "color": "#9e9e9e" },
          "tag.attribute": { "color": "#0b6a78", "font_style": "italic" },
          "tag.doctype": { "color": "#8c3a1e" },
          "parameter": { "color": "#1a1a1a" },
          "label": { "color": "#0b6a78" },
          "namespace": { "color": "#1a7f37", "font_style": "italic" },
          "module": { "color": "#1a7f37", "font_style": "italic" },
          "enum": { "color": "#1a7f37" },
          "concept": { "color": "#0b6a78" },
          "field": { "color": "#1a1a1a" },
          "text": { "color": "#1a1a1a" },
          "text.literal": { "color": "#a3212b" },
          "title": { "color": "#7a5c00", "font_weight": 700 },
          "title.command": { "color": "#7a5c00" },
          "title.document": { "color": "#7a5c00" },
          "title.introduction": { "color": "#7a5c00" },
          "title.longform": { "color": "#7a5c00" },
          "emphasis": { "color": "#4b6577", "font_style": "italic" },
          "emphasis.strong": { "color": "#1a1a1a", "font_weight": 700 },
          "embedded": { "color": "#a3212b" },
          "entity": { "color": "#0b6a78" },
          "preproc": { "color": "#8c3a1e" },
          "primary": { "color": "#6b6252" },
          "variant": { "color": "#b31d28" },
          "diff.minus": { "color": "#b31d28" },
          "diff.plus": { "color": "#1a7f37" },
          "hint": { "color": "#9e9e9e", "font_style": "italic" },
          "predictive": { "color": "#9e9e9e" },
          "predoc": { "color": "#b31d28" },
          "symbol": { "color": "#0b6a78" },
          "link_uri": { "color": "#0b6a78", "font_style": "italic" },
          "link_text": { "color": "#0b6a78" },
          "spellcheck.file": { "color": "#1a1a1a" },
          "markup.heading": { "color": "#7a5c00", "font_weight": 700 },
          "markup.bold": { "color": "#1a1a1a", "font_weight": 700 },
          "markup.italic": { "color": "#4b6577", "font_style": "italic" },
          "markup.quote": { "color": "#4b6577", "font_style": "italic" },
          "markup.code": { "color": "#a3212b" },
          "markup.link": { "color": "#0b6a78", "font_style": "underline" },
          "markup.list": { "color": "#7a5c00" }
        }
      }
    }
  ]
}
