{
  "$schema": "https://zed.dev/schema/themes/v0.2.0",
  "author": "neoh",
  "name": "Simple Light",
  "themes": [
    {
      "name": "Simple Light Hazy",
      "appearance": "light",
      "style": {
        // ============================================================
        // 毛玻璃层级：与 Simple Dark Hazy 相同的 alpha 结构
        //   editor / panel 完全透明 (00)，表面 70% (B3)，
        //   标题栏/状态栏 74% (BC)，浮层 90% (E6)
        // 底色为 simple-light 的纯白 + go.dev 藏蓝 UI
        // ============================================================
        "background.appearance": "blurred",
        "background": "#ffffffB3",
        "editor.background": "#ffffff00",
        "editor.gutter.background": "#ffffff00",
        "editor.subheader.background": "#f3f3f3BC",
        "editor.line_number": "#9e9e9e",
        "editor.active_line_number": "#000000",
        "editor.foreground": "#000000",
        "editor.element.background": "#ffffff22",
        "editor.invisible": "#dcdcdc",
        "editor.indent_guide": "#e6e6e6",
        "editor.indent_guide_active": "#b0b0b0",
        "editor.wrap_guide": "#e6e6e6",
        "editor.active_wrap_guide": "#b0b0b0",
        "editor.highlighted_line.background": "#f2f2f2DD",
        "editor.selection.background": "#cce4ffE6",
        "editor.selection.foreground": "#000000",
        "editor.document_highlight.read_background": "#cce4ff33",
        "editor.document_highlight.write_background": "#cce4ff40",
        "editor.document_highlight.bracket_background": "#00789426",
        "editor.search.match_background": "#FDE3A780",
        "editor.active_search_match_background": "#FDE3A7B3",
        "editor.hunk.background": "#388E3C26",
        "editor.hunk_line": "#388E3C",
        "editor.deleted_line_background": "#E11B1426",
        "scrollbar.track.background": "#f3f3f32D",
        "scrollbar.track.border": "#dcdcdc",
        "scrollbar.thumb.background": "#c0c0c0B3",
        "scrollbar.thumb.hover_background": "#9e9e9eB3",
        "scrollbar.thumb.active_background": "#00789480",
        "minimap.thumb.background": "#c0c0c059",
        "minimap.thumb.hover_background": "#9e9e9e73",
        "minimap.thumb.active_background": "#007894A6",

        // ---- 窗口 / 标题栏：go.dev 藏蓝 ----
        "title_bar.background": "#007894BC",
        "title_bar.inactive_background": "#005c726B",
        "toolbar.background": "#ffffff1A",
        "panel.background": "#ffffff00",
        "panel.overlay_background": "#ffffffF2",
        "panel.indent_guide": "#e6e6e6A6",
        "panel.indent_guide_active": "#b0b0b0",
        "status_bar.background": "#007894BC",
        "status_bar.border": "#006982A6",
        "tab_bar.background": "#f3f3f311",
        "tab.active_background": "#ffffff55",
        "tab.inactive_background": "#f3f3f322",
        "tab.active_foreground": "#000000",
        "tab.inactive_foreground": "#9e9e9e",
        "tab_bar.active_border": "#007894",
        "tab_bar.inactive_border": "#dcdcdc",

        "surface.background": "#f3f3f3BC",
        "element.background": "#ffffff22",
        "element.hover": "#ecececAA",
        "element.active": "#dcdcdcD9",
        "element.selected": "#cce4ffCC",
        "element.disabled": "#ffffff3F",
        "ghost_element.background": "#ffffff11",
        "ghost_element.hover": "#ececec5A",
        "ghost_element.active": "#dcdcdc99",
        "ghost_element.selected": "#cce4ffB3",
        "elevated_surface.background": "#ffffffE6",
        "notification.background": "#ffffffE6",
        "notification.border": "#d4d4d4",

        // ---- 边框 ----
        "border": "#d4d4d48C",
        "border.variant": "#dcdcdc",
        "border.focused": "#007894",
        "border.selected": "#00789498",
        "border.transparent": "#ffffff00",
        "border.disabled": "#d4d4d4",
        "pane.focused_border": "#007894",
        "pane_group.border": "#dcdcdcB8",
        "pane.unfocused_border": "#dcdcdc",
        "panel.focused_border": "#007894",
        "panel.indent_guide_hover": "#007894",

        // ---- 文本 ----
        "text": "#000000",
        "text.accent": "#007894",
        "text.muted": "#9e9e9e",
        "text.disabled": "#b0b0b0",
        "text.placeholder": "#9e9e9e",

        // ---- 列表 选中/悬停 ----
        "list.active_hover_background": "#f0f0f0",
        "list.focus_foreground": "#000000",
        "list.highlight_foreground": "#007894",
        "list.hover_foreground": "#000000",

        // ---- Git ----
        "version_control.added": "#388E3C",
        "version_control.modified": "#1976D2",
        "version_control.deleted": "#E11B14",
        "version_control.ignored": "#9e9e9e",
        "version_control.renamed": "#1976D2",

        // ---- 状态色 ----
        "error": "#E11B14",
        "error.background": "#E11B1426",
        "error.border": "#a87377",
        "warning": "#B36205",
        "warning.background": "#B3620526",
        "warning.border": "#8a4a04",
        "success": "#388E3C",
        "success.background": "#388E3C26",
        "success.border": "#276429",
        "info": "#1976D2",
        "info.background": "#1976D226",
        "info.border": "#124f91",
        "link_text.hover": "#007894",

        // ---- 终端：simple-light 调色板 ----
        "terminal.background": "#ffffff22",
        "terminal.foreground": "#000000",
        "terminal.bright_foreground": "#000000",
        "terminal.dim_foreground": "#666666",
        "terminal.ansi.background": "#ffffff22",
        "terminal.ansi.black": "#000000",
        "terminal.ansi.dim_black": "#000000",
        "terminal.ansi.bright_black": "#666666",
        "terminal.ansi.red": "#cd3131",
        "terminal.ansi.dim_red": "#8f2320",
        "terminal.ansi.bright_red": "#cd3131",
        "terminal.ansi.green": "#00bc00",
        "terminal.ansi.dim_green": "#008300",
        "terminal.ansi.bright_green": "#14ce14",
        "terminal.ansi.yellow": "#949800",
        "terminal.ansi.dim_yellow": "#666800",
        "terminal.ansi.bright_yellow": "#b5ba00",
        "terminal.ansi.blue": "#0451a5",
        "terminal.ansi.dim_blue": "#033674",
        "terminal.ansi.bright_blue": "#0451a5",
        "terminal.ansi.magenta": "#bc05bc",
        "terminal.ansi.dim_magenta": "#830483",
        "terminal.ansi.bright_magenta": "#bc05bc",
        "terminal.ansi.cyan": "#0598bc",
        "terminal.ansi.dim_cyan": "#046a84",
        "terminal.ansi.bright_cyan": "#0598bc",
        "terminal.ansi.white": "#555555",
        "terminal.ansi.dim_white": "#555555",
        "terminal.ansi.bright_white": "#a5a5a5",

        // ---- Git 状态细分 ----
        "renamed": "#1976D2",
        "renamed.background": "#1976D226",
        "renamed.border": "#1976D240",
        "created": "#388E3C",
        "created.background": "#388E3C26",
        "created.border": "#276429",
        "deleted": "#E11B14",
        "deleted.background": "#E11B1426",
        "deleted.border": "#a20f0e",
        "modified": "#B36205",
        "modified.background": "#B3620526",
        "modified.border": "#8a4a04",
        "conflict": "#f1a5ab",
        "conflict.background": "#E11B1426",
        "conflict.border": "#a87377",
        "hidden": "#9e9e9e",
        "hidden.background": "#ffffff3F",
        "ignored": "#9e9e9e",
        "ignored.background": "#ffffff33",
        "hint": "#9e9e9e",
        "hint.background": "#f3f3f362",
        "predictive": "#9e9e9e",
        "predictive.background": "#ffffff5A",
        "unreachable": "#E11B14",
        "unreachable.background": "#E11B1426",

        // ---- AI / 协作玩家色 ----
        "players": [
          { "background": "#007894", "cursor": "#007894", "selection": "#0078944D" },
          { "background": "#B36205", "cursor": "#B36205", "selection": "#B362054D" },
          { "background": "#388E3C", "cursor": "#388E3C", "selection": "#388E3C4D" },
          { "background": "#bc05bc", "cursor": "#bc05bc", "selection": "#bc05bc4D" },
          { "background": "#cd3131", "cursor": "#cd3131", "selection": "#cd31314D" },
          { "background": "#0598bc", "cursor": "#0598bc", "selection": "#0598bc4D" },
          { "background": "#0451a5", "cursor": "#0451a5", "selection": "#0451a54D" },
          { "background": "#608b4e", "cursor": "#608b4e", "selection": "#608b4e4D" }
        ],
        "debugger.accent": "#B36205",
        "editor.debugger_active_line.background": "#B3620526",

        // ============================================================
        // 语法高亮：simple-light tokenColors 平移
        // 四色极简：藏蓝关键字 / 暗红字符串 / 灰绿注释 / 暗绿常量
        // ============================================================
        "syntax": {
          "comment": { "color": "#608b4e", "font_style": "italic" },
          "comment.doc": { "color": "#608b4e", "font_style": "italic" },
          "comment.documentation": { "color": "#608b4e", "font_style": "italic" },
          "comment.todo": { "color": "#B36205", "font_style": "italic" },
          "comment.error": { "color": "#E11B14", "font_style": "italic" },
          "keyword": { "color": "#005c72" },
          "keyword.modifier": { "color": "#005c72" },
          "keyword.directive": { "color": "#000080" },
          "keyword.directive.define": { "color": "#000080" },
          "string": { "color": "#a31515" },
          "string.escape": { "color": "#098658" },
          "string.regex": { "color": "#098658" },
          "string.special": { "color": "#000080" },
          "string.special.path": { "color": "#000080" },
          "string.special.url": { "color": "#007894", "font_style": "italic" },
          "character": { "color": "#a31515" },
          "character.special": { "color": "#098658" },
          "number": { "color": "#098658" },
          "number.float": { "color": "#098658" },
          "boolean": { "color": "#098658" },
          "constant": { "color": "#098658" },
          "constant.builtin": { "color": "#005c72" },
          "constant.macro": { "color": "#098658" },
          "constructor": { "color": "#6b6252" },
          "function": { "color": "#6b6252" },
          "function.call": { "color": "#6b6252" },
          "function.macro": { "color": "#005c72" },
          "function.builtin": { "color": "#005c72" },
          "function.method": { "color": "#6b6252" },
          "function.method.call": { "color": "#6b6252" },
          "function.decorator": { "color": "#005c72" },
          "type": { "color": "#005c72" },
          "type.builtin": { "color": "#005c72", "font_style": "italic" },
          "type.class.definition": { "color": "#005c72" },
          "type.definition": { "color": "#005c72" },
          "type.interface": { "color": "#005c72", "font_style": "italic" },
          "type.super": { "color": "#005c72", "font_style": "italic" },
          "variable": { "color": "#000000" },
          "variable.builtin": { "color": "#005c72", "font_style": "italic" },
          "variable.member": { "color": "#000000" },
          "variable.parameter": { "color": "#000000" },
          "variable.special": { "color": "#005c72", "font_style": "italic" },
          "property": { "color": "#000000" },
          "attribute": { "color": "#000080", "font_style": "italic" },
          "operator": { "color": "#000000" },
          "punctuation": { "color": "#000000" },
          "punctuation.bracket": { "color": "#000000" },
          "punctuation.delimiter": { "color": "#000000" },
          "punctuation.list_marker": { "color": "#005c72" },
          "punctuation.special": { "color": "#000000" },
          "tag": { "color": "#000080" },
          "tag.delimiter": { "color": "#9e9e9e" },
          "tag.attribute": { "color": "#005c72", "font_style": "italic" },
          "tag.doctype": { "color": "#098658" },
          "parameter": { "color": "#000000" },
          "label": { "color": "#007894" },
          "namespace": { "color": "#000080", "font_style": "italic" },
          "module": { "color": "#000080", "font_style": "italic" },
          "enum": { "color": "#005c72" },
          "concept": { "color": "#007894" },
          "field": { "color": "#000000" },
          "text": { "color": "#000000" },
          "text.literal": { "color": "#a31515" },
          "title": { "color": "#000080", "font_weight": 700 },
          "title.command": { "color": "#000080" },
          "title.document": { "color": "#000080" },
          "title.introduction": { "color": "#000080" },
          "title.longform": { "color": "#000080" },
          "emphasis": { "color": "#608b4e", "font_style": "italic" },
          "emphasis.strong": { "color": "#000000", "font_weight": 700 },
          "embedded": { "color": "#608b4e" },
          "entity": { "color": "#000080" },
          "preproc": { "color": "#000080" },
          "primary": { "color": "#6b6252" },
          "variant": { "color": "#E11B14" },
          "diff.minus": { "color": "#E11B14" },
          "diff.plus": { "color": "#388E3C" },
          "hint": { "color": "#9e9e9e", "font_style": "italic" },
          "predictive": { "color": "#9e9e9e" },
          "predoc": { "color": "#E11B14" },
          "symbol": { "color": "#000080" },
          "link_uri": { "color": "#007894", "font_style": "italic" },
          "link_text": { "color": "#005c72" },
          "spellcheck.file": { "color": "#000000" },
          "markup.heading": { "color": "#000080", "font_weight": 700 },
          "markup.bold": { "color": "#000000", "font_weight": 700 },
          "markup.italic": { "color": "#608b4e", "font_style": "italic" },
          "markup.quote": { "color": "#608b4e", "font_style": "italic" },
          "markup.code": { "color": "#098658" },
          "markup.link": { "color": "#007894", "font_style": "underline" },
          "markup.list": { "color": "#005c72" }
        }
      }
    }
  ]
}
