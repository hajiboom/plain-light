{
  "$schema": "https://zed.dev/schema/themes/v0.2.0",
  "author": "neoh",
  "name": "Simple Dark",
  "themes": [
    {
      "name": "Simple Dark Hazy",
      "appearance": "dark",
      "style": {
        // ============================================================
        // 毛玻璃层级：沿用 Subliminal Nightfall Hazy 的 alpha 结构
        //   editor / panel 完全透明 (00)，表面 70% (B3)，
        //   标题栏/状态栏 74% (BC)，浮层 90% (E6)
        // 配色：Tsoding Gruber Darker（#181818 炭黑 + #ffdd33 黄）
        // ============================================================
        "background.appearance": "blurred",
        "background": "#181818CC",
        "editor.background": "#18181800",
        "editor.gutter.background": "#18181800",
        "editor.subheader.background": "#181818BC",
        "editor.line_number": "#b3b3b3",
        "editor.active_line_number": "#ffdd33",
        "editor.foreground": "#d4d4d4",
        "editor.element.background": "#18181822",
        "editor.invisible": "#3a3a3a",
        "editor.indent_guide": "#404040",
        "editor.indent_guide_active": "#707070",
        "editor.wrap_guide": "#404040",
        "editor.active_wrap_guide": "#707070",
        "editor.highlighted_line.background": "#ffffff0ADD",
        "editor.selection.background": "#504945E6",
        "editor.selection.foreground": "#ffffff",
        "editor.document_highlight.read_background": "#ffdd3333",
        "editor.document_highlight.write_background": "#ffdd3340",
        "editor.document_highlight.bracket_background": "#ffdd3326",
        "editor.search.match_background": "#ffdd3340",
        "editor.active_search_match_background": "#ffdd3373",
        "editor.hunk.background": "#79bf4626",
        "editor.hunk_line": "#79bf46",
        "editor.deleted_line_background": "#f4384126",
        "scrollbar.track.background": "#1818182D",
        "scrollbar.track.border": "#444444",
        "scrollbar.thumb.background": "#504945B3",
        "scrollbar.thumb.hover_background": "#5e544e",
        "scrollbar.thumb.active_background": "#6b5f57",
        "minimap.thumb.background": "#50494559",
        "minimap.thumb.hover_background": "#50494573",
        "minimap.thumb.active_background": "#ffdd33A6",

        // ---- 窗口 / 标题栏：仅顶部复用 go.dev 藏蓝 ----
        "title_bar.background": "#007894BC",
        "title_bar.inactive_background": "#005c726B",
        "toolbar.background": "#1818181A",
        "panel.background": "#18181800",
        "panel.overlay_background": "#181818F2",
        "panel.indent_guide_hover": "#ffdd33",
        "panel.indent_guide": "#444444A6",
        "panel.indent_guide_active": "#707070",
        "status_bar.background": "#141414BC",
        "status_bar.border": "#000000A6",
        "tab_bar.background": "#14141411",
        "tab.active_background": "#18181855",
        "tab.inactive_background": "#14141422",
        "tab.active_foreground": "#ffffff",
        "tab.inactive_foreground": "#a6a6a6",
        "tab_bar.active_border": "#ffdd33",
        "tab_bar.inactive_border": "#444444",

        "surface.background": "#181818BC",
        "element.background": "#18181822",
        "element.hover": "#282828AA",
        "element.active": "#504945D9",
        "element.selected": "#504945CC",
        "element.disabled": "#1818183F",
        "ghost_element.background": "#18181811",
        "ghost_element.hover": "#2828285A",
        "ghost_element.active": "#50494599",
        "ghost_element.selected": "#504945B3",
        "elevated_surface.background": "#282828E6",
        "notification.background": "#282828E6",
        "notification.border": "#504945",

        // ---- 边框 ----
        "border": "#4444448C",
        "border.variant": "#444444",
        "border.focused": "#ffdd33",
        "border.selected": "#ffdd3398",
        "border.transparent": "#18181800",
        "border.disabled": "#504945",
        "pane.focused_border": "#ffdd33",
        "pane_group.border": "#444444B8",
        "pane.unfocused_border": "#444444",
        "panel.focused_border": "#ffdd33",

        // ---- 文本 ----
        "text": "#d4d4d4",
        "text.accent": "#ffdd33",
        "text.muted": "#a6a6a6",
        "text.disabled": "#6b6b6b",
        "text.placeholder": "#8c8c8c",

        // ---- 列表 选中/悬停 ----
        "list.active_hover_background": "#282828",
        "list.focus_foreground": "#ffffff",
        "list.highlight_foreground": "#ffdd33",
        "list.hover_foreground": "#ffffff",

        // ---- Git ----
        "version_control.added": "#79bf46",
        "version_control.modified": "#e2c08d",
        "version_control.deleted": "#f43841",
        "version_control.ignored": "#8c8c8c",
        "version_control.renamed": "#e2c08d",

        // ---- 状态色 ----
        "error": "#f43841",
        "error.background": "#f4384126",
        "error.border": "#a83e44",
        "warning": "#ff9b21",
        "warning.background": "#ff9b2126",
        "warning.border": "#b06f18",
        "success": "#79bf46",
        "success.background": "#79bf4626",
        "success.border": "#4f7f2c",
        "info": "#95a2c9",
        "info.background": "#95a2c926",
        "info.border": "#6b7790",
        "link_text.hover": "#ffdd33",

        // ---- 终端：Gruber Darker / Emacs ANSI ----
        "terminal.background": "#18181822",
        "terminal.foreground": "#cccccc",
        "terminal.bright_foreground": "#e4e4ef",
        "terminal.dim_foreground": "#a6a6a6",
        "terminal.ansi.background": "#18181822",
        "terminal.ansi.black": "#484848",
        "terminal.ansi.dim_black": "#333333",
        "terminal.ansi.bright_black": "#6b6b6b",
        "terminal.ansi.red": "#c73c3f",
        "terminal.ansi.dim_red": "#8f2b2d",
        "terminal.ansi.bright_red": "#ff4f58",
        "terminal.ansi.green": "#73c936",
        "terminal.ansi.dim_green": "#528f27",
        "terminal.ansi.bright_green": "#8fd94f",
        "terminal.ansi.yellow": "#ffdd33",
        "terminal.ansi.dim_yellow": "#b39a24",
        "terminal.ansi.bright_yellow": "#ffe566",
        "terminal.ansi.blue": "#96a6c8",
        "terminal.ansi.dim_blue": "#6b7790",
        "terminal.ansi.bright_blue": "#b0c0e0",
        "terminal.ansi.magenta": "#9e95c7",
        "terminal.ansi.dim_magenta": "#6f688c",
        "terminal.ansi.bright_magenta": "#b8b0dd",
        "terminal.ansi.cyan": "#95a99f",
        "terminal.ansi.dim_cyan": "#6a7a72",
        "terminal.ansi.bright_cyan": "#b0c4ba",
        "terminal.ansi.white": "#e4e4ef",
        "terminal.ansi.dim_white": "#a6a6a6",
        "terminal.ansi.bright_white": "#f4f4ff",

        // ---- 按钮 / 输入 ----
        "renamed": "#e2c08d",
        "renamed.background": "#e2c08d26",
        "renamed.border": "#a08a62",
        "created": "#79bf46",
        "created.background": "#79bf4626",
        "created.border": "#4f7f2c",
        "deleted": "#f43841",
        "deleted.background": "#f4384126",
        "deleted.border": "#85434a",
        "modified": "#e2c08d",
        "modified.background": "#e2c08d26",
        "modified.border": "#a08a62",
        "conflict": "#f1a5ab",
        "conflict.background": "#f4384126",
        "conflict.border": "#a87377",
        "hidden": "#6b6b6b",
        "hidden.background": "#1818183F",
        "ignored": "#6b6b6b",
        "ignored.background": "#18181833",
        "hint": "#a6a6a6",
        "hint.background": "#28282862",
        "predictive": "#6b6b6b",
        "predictive.background": "#1818185A",
        "unreachable": "#f43841",
        "unreachable.background": "#f4384126",

        // ---- AI / 协作玩家色 ----
        "players": [
          { "background": "#ffdd33", "cursor": "#ffdd33", "selection": "#ffdd334D" },
          { "background": "#79bf46", "cursor": "#79bf46", "selection": "#79bf464D" },
          { "background": "#949bb0", "cursor": "#949bb0", "selection": "#949bb04D" },
          { "background": "#9e95c7", "cursor": "#9e95c7", "selection": "#9e95c74D" },
          { "background": "#f43841", "cursor": "#f43841", "selection": "#f438414D" },
          { "background": "#94b0a6", "cursor": "#94b0a6", "selection": "#94b0a64D" },
          { "background": "#ff6200", "cursor": "#ff6200", "selection": "#ff62004D" },
          { "background": "#c18132", "cursor": "#c18132", "selection": "#c181324D" }
        ],
        "debugger.accent": "#ffdd33",
        "editor.debugger_active_line.background": "#ffdd3326",

        // ============================================================
        // 语法高亮：simple-dark tokenColors 平移（Gruber Darker）
        // ============================================================
        "syntax": {
          "comment": { "color": "#c18132" },
          "comment.doc": { "color": "#79bf46" },
          "comment.documentation": { "color": "#79bf46" },
          "comment.todo": { "color": "#ffdd33", "font_style": "italic" },
          "comment.error": { "color": "#f43841", "font_style": "italic" },
          "keyword": { "color": "#ffdd33" },
          "keyword.modifier": { "color": "#ffdd33" },
          "keyword.directive": { "color": "#94b0a6" },
          "keyword.directive.define": { "color": "#94b0a6" },
          "string": { "color": "#79bf46" },
          "string.escape": { "color": "#ffdd33" },
          "string.regex": { "color": "#d4d4d4" },
          "string.special": { "color": "#79bf46" },
          "string.special.path": { "color": "#95a2c9" },
          "string.special.url": { "color": "#95a2c9", "font_style": "italic" },
          "character": { "color": "#79bf46" },
          "character.special": { "color": "#ffdd33" },
          "number": { "color": "#ff6200" },
          "number.float": { "color": "#ff6200" },
          "boolean": { "color": "#94b0a6" },
          "constant": { "color": "#94b0a6" },
          "constant.builtin": { "color": "#ffdd33" },
          "constant.macro": { "color": "#94b0a6" },
          "constructor": { "color": "#949bb0" },
          "function": { "color": "#949bb0" },
          "function.call": { "color": "#949bb0" },
          "function.macro": { "color": "#95a2c9" },
          "function.builtin": { "color": "#ffdd33" },
          "function.method": { "color": "#949bb0" },
          "function.method.call": { "color": "#949bb0" },
          "function.decorator": { "color": "#95a2c9" },
          "type": { "color": "#94b0a6" },
          "type.builtin": { "color": "#94b0a6", "font_style": "italic" },
          "type.class.definition": { "color": "#94b0a6" },
          "type.definition": { "color": "#94b0a6" },
          "type.interface": { "color": "#94b0a6", "font_style": "italic" },
          "type.super": { "color": "#94b0a6", "font_style": "italic" },
          "variable": { "color": "#d4d4d4" },
          "variable.builtin": { "color": "#949bb0", "font_style": "italic" },
          "variable.member": { "color": "#d4d4d4" },
          "variable.parameter": { "color": "#d4d4d4" },
          "variable.special": { "color": "#949bb0", "font_style": "italic" },
          "property": { "color": "#d4d4d4" },
          "attribute": { "color": "#95a2c9", "font_style": "italic" },
          "operator": { "color": "#d4d4d4" },
          "punctuation": { "color": "#d4d4d4" },
          "punctuation.bracket": { "color": "#d4d4d4" },
          "punctuation.delimiter": { "color": "#d4d4d4" },
          "punctuation.list_marker": { "color": "#ffdd33" },
          "punctuation.special": { "color": "#d4d4d4" },
          "tag": { "color": "#ffdd33" },
          "tag.delimiter": { "color": "#d4d4d4" },
          "tag.attribute": { "color": "#95a2c9", "font_style": "italic" },
          "tag.doctype": { "color": "#94b0a6" },
          "parameter": { "color": "#d4d4d4" },
          "label": { "color": "#949bb0" },
          "namespace": { "color": "#94b0a6", "font_style": "italic" },
          "module": { "color": "#94b0a6", "font_style": "italic" },
          "enum": { "color": "#94b0a6" },
          "concept": { "color": "#94b0a6" },
          "field": { "color": "#d4d4d4" },
          "text": { "color": "#d4d4d4" },
          "text.literal": { "color": "#79bf46" },
          "title": { "color": "#ffdd33", "font_weight": 700 },
          "title.command": { "color": "#ffdd33" },
          "title.document": { "color": "#ffdd33" },
          "title.introduction": { "color": "#ffdd33" },
          "title.longform": { "color": "#ffdd33" },
          "emphasis": { "color": "#ffdd33", "font_style": "italic" },
          "emphasis.strong": { "color": "#d4d4d4", "font_weight": 700 },
          "embedded": { "color": "#ffdd33" },
          "entity": { "color": "#95a2c9" },
          "preproc": { "color": "#94b0a6" },
          "primary": { "color": "#f1a5ab" },
          "variant": { "color": "#f43841" },
          "diff.minus": { "color": "#f43841" },
          "diff.plus": { "color": "#79bf46" },
          "hint": { "color": "#8c8c8c", "font_style": "italic" },
          "predictive": { "color": "#6b6b6b" },
          "predoc": { "color": "#f43841" },
          "symbol": { "color": "#95a2c9" },
          "link_uri": { "color": "#95a2c9", "font_style": "italic" },
          "link_text": { "color": "#ffdd33" },
          "spellcheck.file": { "color": "#d4d4d4" },
          "markup.heading": { "color": "#ffdd33", "font_weight": 700 },
          "markup.bold": { "color": "#d4d4d4", "font_weight": 700 },
          "markup.italic": { "color": "#ffdd33", "font_style": "italic" },
          "markup.quote": { "color": "#ff9b21", "font_style": "italic" },
          "markup.code": { "color": "#79bf46" },
          "markup.link": { "color": "#95a2c9", "font_style": "underline" },
          "markup.list": { "color": "#ffdd33" }
        }
      }
    }
  ]
}
