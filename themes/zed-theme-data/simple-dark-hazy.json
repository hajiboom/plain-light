{
  "$schema": "https://zed.dev/schema/themes/v0.2.0",
  "author": "neoh",
  "name": "Simple Dark",
  "themes": [
    {
      "name": "Simple Dark Hazy",
      "appearance": "dark",
      "style": {
        // ============================================================
        // 毛玻璃层级：沿用 Subliminal Nightfall Hazy 的 alpha 结构
        //   editor / panel 完全透明 (00)，表面 70% (B3)，
        //   标题栏/状态栏 74% (BC)，浮层 90% (E6)
        // 配色：Tsoding Gruber Darker 低亮版（#181818 炭黑 + #d8bd55 哑金）
        // 峰值亮度与饱和度整体下调，减轻暗底亮字的光晕（halation）
        // ============================================================
        "background.appearance": "blurred",
        "background": "#181818CC",
        "editor.background": "#18181800",
        "editor.gutter.background": "#18181800",
        "editor.subheader.background": "#181818BC",
        "editor.line_number": "#9a9a9a",
        "editor.active_line_number": "#d8bd55",
        "editor.foreground": "#c6c6c6",
        "editor.element.background": "#18181822",
        "editor.invisible": "#3a3a3a",
        "editor.indent_guide": "#404040",
        "editor.indent_guide_active": "#707070",
        "editor.wrap_guide": "#404040",
        "editor.active_wrap_guide": "#707070",
        "editor.highlighted_line.background": "#e8e8e80ADD",
        "editor.selection.background": "#504945E6",
        "editor.selection.foreground": "#e8e8e8",
        "editor.document_highlight.read_background": "#d8bd5533",
        "editor.document_highlight.write_background": "#d8bd5540",
        "editor.document_highlight.bracket_background": "#d8bd5526",
        "editor.search.match_background": "#d8bd5540",
        "editor.active_search_match_background": "#d8bd5573",
        "editor.hunk.background": "#7fb75726",
        "editor.hunk_line": "#7fb757",
        "editor.deleted_line_background": "#e35d6426",
        "scrollbar.track.background": "#1818182D",
        "scrollbar.track.border": "#444444",
        "scrollbar.thumb.background": "#504945B3",
        "scrollbar.thumb.hover_background": "#5e544e",
        "scrollbar.thumb.active_background": "#6b5f57",
        "minimap.thumb.background": "#50494559",
        "minimap.thumb.hover_background": "#50494573",
        "minimap.thumb.active_background": "#d8bd55A6",

        // ---- 窗口 / 标题栏：仅顶部复用 go.dev 藏蓝 ----
        "title_bar.background": "#007894BC",
        "title_bar.inactive_background": "#005c726B",
        "toolbar.background": "#1818181A",
        "panel.background": "#18181800",
        "panel.overlay_background": "#181818F2",
        "panel.indent_guide_hover": "#d8bd55",
        "panel.indent_guide": "#444444A6",
        "panel.indent_guide_active": "#707070",
        "status_bar.background": "#141414BC",
        "status_bar.border": "#000000A6",
        "tab_bar.background": "#14141411",
        "tab.active_background": "#18181855",
        "tab.inactive_background": "#14141422",
        "tab.active_foreground": "#e8e8e8",
        "tab.inactive_foreground": "#a6a6a6",
        "tab_bar.active_border": "#d8bd55",
        "tab_bar.inactive_border": "#444444",

        "surface.background": "#181818BC",
        "element.background": "#18181822",
        "element.hover": "#282828AA",
        "element.active": "#504945D9",
        "element.selected": "#504945CC",
        "element.disabled": "#1818183F",
        "ghost_element.background": "#18181811",
        "ghost_element.hover": "#2828285A",
        "ghost_element.active": "#50494599",
        "ghost_element.selected": "#504945B3",
        "elevated_surface.background": "#282828E6",
        "notification.background": "#282828E6",
        "notification.border": "#504945",

        // ---- 边框 ----
        "border": "#4444448C",
        "border.variant": "#444444",
        "border.focused": "#d8bd55",
        "border.selected": "#d8bd5598",
        "border.transparent": "#18181800",
        "border.disabled": "#504945",
        "pane.focused_border": "#d8bd55",
        "pane_group.border": "#444444B8",
        "pane.unfocused_border": "#444444",
        "panel.focused_border": "#d8bd55",

        // ---- 文本 ----
        "text": "#c6c6c6",
        "text.accent": "#d8bd55",
        "text.muted": "#a6a6a6",
        "text.disabled": "#6b6b6b",
        "text.placeholder": "#8c8c8c",

        // ---- 列表 选中/悬停 ----
        "list.active_hover_background": "#282828",
        "list.focus_foreground": "#e8e8e8",
        "list.highlight_foreground": "#d8bd55",
        "list.hover_foreground": "#e8e8e8",

        // ---- Git ----
        "version_control.added": "#7fb757",
        "version_control.modified": "#d6b98d",
        "version_control.deleted": "#e35d64",
        "version_control.ignored": "#8c8c8c",
        "version_control.renamed": "#d6b98d",

        // ---- 状态色 ----
        "error": "#e35d64",
        "error.background": "#e35d6426",
        "error.border": "#a83e44",
        "warning": "#d99f57",
        "warning.background": "#d99f5726",
        "warning.border": "#b06f18",
        "success": "#7fb757",
        "success.background": "#7fb75726",
        "success.border": "#4f7f2c",
        "info": "#95a2c9",
        "info.background": "#95a2c926",
        "info.border": "#6b7790",
        "link_text.hover": "#d8bd55",

        // ---- 终端：Gruber Darker / Emacs ANSI ----
        "terminal.background": "#18181822",
        "terminal.foreground": "#c6c6c6",
        "terminal.bright_foreground": "#d6d7e2",
        "terminal.dim_foreground": "#a6a6a6",
        "terminal.ansi.background": "#18181822",
        "terminal.ansi.black": "#484848",
        "terminal.ansi.dim_black": "#333333",
        "terminal.ansi.bright_black": "#6b6b6b",
        "terminal.ansi.red": "#d05f61",
        "terminal.ansi.dim_red": "#8f2b2d",
        "terminal.ansi.bright_red": "#e8707a",
        "terminal.ansi.green": "#7dbf55",
        "terminal.ansi.dim_green": "#528f27",
        "terminal.ansi.bright_green": "#93cd6c",
        "terminal.ansi.yellow": "#d8bd55",
        "terminal.ansi.dim_yellow": "#b39a24",
        "terminal.ansi.bright_yellow": "#e5cf6e",
        "terminal.ansi.blue": "#96a6c8",
        "terminal.ansi.dim_blue": "#6b7790",
        "terminal.ansi.bright_blue": "#a8b6d2",
        "terminal.ansi.magenta": "#9e95c7",
        "terminal.ansi.dim_magenta": "#6f688c",
        "terminal.ansi.bright_magenta": "#b0a8d0",
        "terminal.ansi.cyan": "#95a99f",
        "terminal.ansi.dim_cyan": "#6a7a72",
        "terminal.ansi.bright_cyan": "#a8bcb2",
        "terminal.ansi.white": "#d6d7e2",
        "terminal.ansi.dim_white": "#a6a6a6",
        "terminal.ansi.bright_white": "#dfe0ea",

        // ---- 按钮 / 输入 ----
        "renamed": "#d6b98d",
        "renamed.background": "#d6b98d26",
        "renamed.border": "#a08a62",
        "created": "#7fb757",
        "created.background": "#7fb75726",
        "created.border": "#4f7f2c",
        "deleted": "#e35d64",
        "deleted.background": "#e35d6426",
        "deleted.border": "#85434a",
        "modified": "#d6b98d",
        "modified.background": "#d6b98d26",
        "modified.border": "#a08a62",
        "conflict": "#dc9ba1",
        "conflict.background": "#e35d6426",
        "conflict.border": "#a87377",
        "hidden": "#6b6b6b",
        "hidden.background": "#1818183F",
        "ignored": "#6b6b6b",
        "ignored.background": "#18181833",
        "hint": "#a6a6a6",
        "hint.background": "#28282862",
        "predictive": "#6b6b6b",
        "predictive.background": "#1818185A",
        "unreachable": "#e35d64",
        "unreachable.background": "#e35d6426",

        // ---- AI / 协作玩家色 ----
        "players": [
          { "background": "#d8bd55", "cursor": "#d8bd55", "selection": "#d8bd554D" },
          { "background": "#7fb757", "cursor": "#7fb757", "selection": "#7fb7574D" },
          { "background": "#949bb0", "cursor": "#949bb0", "selection": "#949bb04D" },
          { "background": "#9e95c7", "cursor": "#9e95c7", "selection": "#9e95c74D" },
          { "background": "#e35d64", "cursor": "#e35d64", "selection": "#e35d644D" },
          { "background": "#94b0a6", "cursor": "#94b0a6", "selection": "#94b0a64D" },
          { "background": "#dc7a45", "cursor": "#dc7a45", "selection": "#dc7a454D" },
          { "background": "#c18132", "cursor": "#c18132", "selection": "#c181324D" }
        ],
        "debugger.accent": "#d8bd55",
        "editor.debugger_active_line.background": "#d8bd5526",

        // ============================================================
        // 语法高亮：simple-dark tokenColors 平移（Gruber Darker 低亮版）
        // ============================================================
        "syntax": {
          "comment": { "color": "#858585" },
          "comment.doc": { "color": "#858585" },
          "comment.documentation": { "color": "#858585" },
          "comment.todo": { "color": "#d8bd55", "font_style": "italic" },
          "comment.error": { "color": "#e35d64", "font_style": "italic" },
          "keyword": { "color": "#d8bd55" },
          "keyword.modifier": { "color": "#d8bd55" },
          "keyword.directive": { "color": "#94b0a6" },
          "keyword.directive.define": { "color": "#94b0a6" },
          "string": { "color": "#7fb757" },
          "string.escape": { "color": "#d8bd55" },
          "string.regex": { "color": "#c6c6c6" },
          "string.special": { "color": "#7fb757" },
          "string.special.path": { "color": "#95a2c9" },
          "string.special.url": { "color": "#95a2c9", "font_style": "italic" },
          "character": { "color": "#7fb757" },
          "character.special": { "color": "#d8bd55" },
          "number": { "color": "#dc7a45" },
          "number.float": { "color": "#dc7a45" },
          "boolean": { "color": "#94b0a6" },
          "constant": { "color": "#94b0a6" },
          "constant.builtin": { "color": "#d8bd55" },
          "constant.macro": { "color": "#94b0a6" },
          "constructor": { "color": "#949bb0" },
          "function": { "color": "#949bb0" },
          "function.call": { "color": "#949bb0" },
          "function.macro": { "color": "#95a2c9" },
          "function.builtin": { "color": "#d8bd55" },
          "function.method": { "color": "#949bb0" },
          "function.method.call": { "color": "#949bb0" },
          "function.decorator": { "color": "#95a2c9" },
          "type": { "color": "#94b0a6" },
          "type.builtin": { "color": "#94b0a6", "font_style": "italic" },
          "type.class.definition": { "color": "#94b0a6" },
          "type.definition": { "color": "#94b0a6" },
          "type.interface": { "color": "#94b0a6", "font_style": "italic" },
          "type.super": { "color": "#94b0a6", "font_style": "italic" },
          "variable": { "color": "#c6c6c6" },
          "variable.builtin": { "color": "#949bb0", "font_style": "italic" },
          "variable.member": { "color": "#c6c6c6" },
          "variable.parameter": { "color": "#c6c6c6" },
          "variable.special": { "color": "#949bb0", "font_style": "italic" },
          "property": { "color": "#c6c6c6" },
          "attribute": { "color": "#95a2c9", "font_style": "italic" },
          "operator": { "color": "#c6c6c6" },
          "punctuation": { "color": "#c6c6c6" },
          "punctuation.bracket": { "color": "#c6c6c6" },
          "punctuation.delimiter": { "color": "#c6c6c6" },
          "punctuation.list_marker": { "color": "#d8bd55" },
          "punctuation.special": { "color": "#c6c6c6" },
          "tag": { "color": "#d8bd55" },
          "tag.delimiter": { "color": "#c6c6c6" },
          "tag.attribute": { "color": "#95a2c9", "font_style": "italic" },
          "tag.doctype": { "color": "#94b0a6" },
          "parameter": { "color": "#c6c6c6" },
          "label": { "color": "#949bb0" },
          "namespace": { "color": "#94b0a6", "font_style": "italic" },
          "module": { "color": "#94b0a6", "font_style": "italic" },
          "enum": { "color": "#94b0a6" },
          "concept": { "color": "#94b0a6" },
          "field": { "color": "#c6c6c6" },
          "text": { "color": "#c6c6c6" },
          "text.literal": { "color": "#7fb757" },
          "title": { "color": "#d8bd55", "font_weight": 700 },
          "title.command": { "color": "#d8bd55" },
          "title.document": { "color": "#d8bd55" },
          "title.introduction": { "color": "#d8bd55" },
          "title.longform": { "color": "#d8bd55" },
          "emphasis": { "color": "#d8bd55", "font_style": "italic" },
          "emphasis.strong": { "color": "#c6c6c6", "font_weight": 700 },
          "embedded": { "color": "#d8bd55" },
          "entity": { "color": "#95a2c9" },
          "preproc": { "color": "#94b0a6" },
          "primary": { "color": "#dc9ba1" },
          "variant": { "color": "#e35d64" },
          "diff.minus": { "color": "#e35d64" },
          "diff.plus": { "color": "#7fb757" },
          "hint": { "color": "#8c8c8c", "font_style": "italic" },
          "predictive": { "color": "#6b6b6b" },
          "predoc": { "color": "#e35d64" },
          "symbol": { "color": "#95a2c9" },
          "link_uri": { "color": "#95a2c9", "font_style": "italic" },
          "link_text": { "color": "#d8bd55" },
          "spellcheck.file": { "color": "#c6c6c6" },
          "markup.heading": { "color": "#d8bd55", "font_weight": 700 },
          "markup.bold": { "color": "#c6c6c6", "font_weight": 700 },
          "markup.italic": { "color": "#d8bd55", "font_style": "italic" },
          "markup.quote": { "color": "#d99f57", "font_style": "italic" },
          "markup.code": { "color": "#7fb757" },
          "markup.link": { "color": "#95a2c9", "font_style": "underline" },
          "markup.list": { "color": "#d8bd55" }
        }
      }
    }
  ]
}
